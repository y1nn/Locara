    <None Remove="Stubs/**" />
    <Compile Include="..\Locara.Core\UnityClassicRtlReflow.cs" Link="UnityClassicRtlReflow.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Stubs\UnityEngine\Locara.UnityEngine.Stub.csproj" Private="false" />
    <ProjectReference Include="Stubs\BepInEx\Locara.BepInEx.Stub.csproj" Private="false" />
  </ItemGroup>
</Project>
