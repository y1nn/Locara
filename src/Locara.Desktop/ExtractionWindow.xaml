<Window x:Class="Locara.Desktop.ExtractionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="إعداد الاستخراج" Width="860" Height="650"
        MinWidth="620" MinHeight="450" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ComboBox x:Name="ResourceChoices" SelectionChanged="LoadResource" FlowDirection="LeftToRight"/>
  <StackPanel x:Name="TableControls" Grid.Row="1" Visibility="Collapsed">
   <WrapPanel>
    <TextBlock Text="الورقة" VerticalAlignment="Center"/><ComboBox x:Name="Sheets" Width="165" SelectionChanged="ChangeSheet"/>
    <TextBlock Text="المعرّف" VerticalAlignment="Center"/><ComboBox x:Name="KeyColumn" Width="140"/>
    <TextBlock Text="المصدر" VerticalAlignment="Center"/><ComboBox x:Name="SourceColumn" Width="140"/>
    <TextBlock Text="الترجمة" VerticalAlignment="Center"/><ComboBox x:Name="TargetColumn" Width="140" IsEditable="True"/>
   </WrapPanel>
   <TextBlock Text="اختر عمود الترجمة أو اكتب اسماً لإنشاء عمود جديد." TextWrapping="Wrap"/>
  </StackPanel>
  <DataGrid x:Name="Sample" Grid.Row="2" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
            CanUserAddRows="False" EnableRowVirtualization="True" FlowDirection="LeftToRight"/>
  <ListBox x:Name="Fields" Grid.Row="2" Visibility="Collapsed" SelectionMode="Extended" FlowDirection="LeftToRight">
   <ListBox.ItemTemplate>
    <DataTemplate>
     <StackPanel Margin="3">
      <TextBlock Text="{Binding Locator}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Source}" TextWrapping="Wrap"/>
     </StackPanel>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <TextBlock x:Name="Feedback" Grid.Row="3" TextWrapping="Wrap"/>
  <WrapPanel Grid.Row="4">
   <Button x:Name="SaveRule" Content="حفظ الإعداد" Click="Save" IsEnabled="False"/>
   <Button x:Name="ResetRule" Content="استعادة الإعداد التلقائي" Click="Reset" IsEnabled="False"/>
   <Button Content="إلغاء" IsCancel="True"/>
  </WrapPanel>
 </Grid>
</Window>
