<Window x:Class="Locara.Desktop.ExtractionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ضبط حقول الاستخراج"
        Width="880" Height="660" MinWidth="620" MinHeight="450"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
 <Grid Margin="20,18" TextElement.Foreground="{DynamicResource TextPrimary}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0" Margin="0,0,0,10">
   <TextBlock Text="المورد المختار لضبط الحقول:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
   <ComboBox x:Name="ResourceChoices" SelectionChanged="LoadResource" FlowDirection="LeftToRight"/>
  </StackPanel>

  <Border x:Name="TableControls" Grid.Row="1" Style="{StaticResource SubtleCardBorderStyle}" Visibility="Collapsed" Margin="0,0,0,10">
   <StackPanel>
    <Grid Margin="0,0,0,8">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="الورقة:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
      <ComboBox x:Name="Sheets" SelectionChanged="ChangeSheet"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="المعرّف:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
      <ComboBox x:Name="KeyColumn"/>
     </StackPanel>
     <StackPanel Grid.Column="4">
      <TextBlock Text="المصدر:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
      <ComboBox x:Name="SourceColumn"/>
     </StackPanel>
     <StackPanel Grid.Column="6">
      <TextBlock Text="الترجمة:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
      <ComboBox x:Name="TargetColumn" IsEditable="True"/>
     </StackPanel>
    </Grid>
    <TextBlock Text="اختر عمود الترجمة أو اكتب اسماً لإنشاء عمود جديد." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>

  <DataGrid x:Name="Sample" Grid.Row="2" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" FlowDirection="LeftToRight"/>
  <ListBox x:Name="Fields" Grid.Row="2" Visibility="Collapsed" SelectionMode="Extended" FlowDirection="LeftToRight">
   <ListBox.ItemTemplate>
    <DataTemplate>
     <StackPanel Margin="4,2">
      <TextBlock Text="{Binding Locator}" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}"/>
      <TextBlock Text="{Binding Source}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
     </StackPanel>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>

  <TextBlock x:Name="Feedback" Grid.Row="3" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,8"/>

  <WrapPanel Grid.Row="4">
   <Button x:Name="SaveRule" Content="حفظ الإعداد" Click="Save" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}"/>
   <Button x:Name="ResetRule" Content="استعادة الإعداد التلقائي" Click="Reset" IsEnabled="False"/>
   <Button Content="إلغاء" IsCancel="True"/>
  </WrapPanel>
 </Grid>
</Window>
