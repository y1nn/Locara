<Window x:Class="Locara.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locara — استوديو تعريب الألعاب"
        Icon="Assets/locara.ico"
        Width="1360" Height="860" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FlowDirection="RightToLeft"
        PreviewKeyDown="WindowPreviewKeyDown">

 <Grid Background="{DynamicResource BgCanvas}" TextElement.Foreground="{DynamicResource TextPrimary}">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="248"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- ==================== RIGHT SIDEBAR STUDIO RAIL ==================== -->
  <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="14,16">
   <DockPanel LastChildFill="True">

    <!-- Brand Identity & Theme Toggle (In RTL Grid: Col 0 = Physical Right, Col 1 = Physical Left) -->
    <Grid DockPanel.Dock="Top" Margin="2,0,2,16">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <Image Source="Assets/locara-icon.png" FlowDirection="LeftToRight" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="Locara" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock x:Name="ProjectTitle" Text="استوديو التعريب" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="108"/>
      </StackPanel>
     </StackPanel>
     <Button x:Name="ThemeToggleButton" Grid.Column="1" Click="ToggleThemeClick" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderSubtle}" Padding="9,5" Margin="0" VerticalAlignment="Center" FontSize="11.5" ToolTip="تبديل المظهر الداكن / الفاتح">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Path x:Name="ThemeSunIcon" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Stroke="{DynamicResource AccentIndicator}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
             Data="M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7 M12,2 L12,4 M12,20 L12,22 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M2,12 L4,12 M20,12 L22,12 M4.93,19.07 L6.34,17.66 M17.66,6.34 L19.07,4.93"/>
       <Path x:Name="ThemeMoonIcon" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" Stroke="{DynamicResource AccentIndicator}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
             Data="M21,12.79 A9,9 0 1 1 11.21,3 A7,7 0 0 0 21,12.79 Z"/>
       <TextBlock x:Name="ThemeToggleText" Text="فاتح" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
      </StackPanel>
     </Button>
    </Grid>

    <!-- Quick Project Open/New Buttons -->
    <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,14">
     <Button x:Name="HeaderNewButton" Content="+ مشروع جديد" Click="CreateProject" FontSize="12" Padding="8,7" Margin="0,0,4,0"/>
     <Button x:Name="HeaderOpenButton" Content="فتح مشروع" Click="OpenProject" FontSize="12" Padding="8,7" Margin="4,0,0,0"/>
    </UniformGrid>

    <!-- Home / Library Nav -->
    <RadioButton x:Name="NavLibrary" DockPanel.Dock="Top" GroupName="StudioNav" Style="{StaticResource RailNavRadioStyle}" IsChecked="True" Click="NavLibraryClick" Content="مكتبتي والمشاريع"/>

    <!-- Pipeline Divider -->
    <TextBlock DockPanel.Dock="Top" Text="مراحل التعريب" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="10,16,10,6"/>

    <!-- 4 Focused Workflow Stages -->
    <StackPanel DockPanel.Dock="Top">
     <RadioButton x:Name="NavFiles" GroupName="StudioNav" Style="{StaticResource RailNavRadioStyle}" IsEnabled="False" Click="NavFilesClick" Content="1. المصدر والملفات"/>
     <RadioButton x:Name="NavTranslation" GroupName="StudioNav" Style="{StaticResource RailNavRadioStyle}" IsEnabled="False" Click="NavTranslationClick" Content="2. البوتات والترجمة"/>
     <RadioButton x:Name="NavEditor" GroupName="StudioNav" Style="{StaticResource RailNavRadioStyle}" IsEnabled="False" Click="NavEditorClick" Content="3. المحرّر والمراجعة"/>
     <RadioButton x:Name="NavPackages" GroupName="StudioNav" Style="{StaticResource RailNavRadioStyle}" IsEnabled="False" Click="NavPackagesClick" Content="4. الخط والتثبيت"/>
    </StackPanel>

    <!-- Bottom Settings & API Footer -->
    <StackPanel DockPanel.Dock="Bottom">
     <Button x:Name="UpdateAvailableBadge" Click="UpdateBadgeClick" Visibility="Collapsed"
             Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentIndicator}"
             Foreground="{DynamicResource AccentIndicator}" BorderThickness="1"
             Padding="10,7" Margin="0,0,0,8" HorizontalContentAlignment="Stretch"
             ToolTip="يتوفر إصدار رسمي أحدث من Locara على GitHub — اضغط لفتح صفحة الإصدار">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AccentIndicator}" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBlock Grid.Column="1" x:Name="UpdateAvailableBadgeText" Text="تحديث متاح" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       <TextBlock Grid.Column="2" Text="↗" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentIndicator}" VerticalAlignment="Center" Margin="6,0,0,0"/>
      </Grid>
     </Button>
     <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="4,10"/>
     <RadioButton x:Name="NavSettings" GroupName="StudioNav" Style="{StaticResource RailNavRadioStyle}" Click="NavSettingsClick">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
             Data="M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 M19.4,15 A1.65,1.65 0 0 0 19.73,16.82 L19.79,16.88 A2,2 0 1 1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0 0 15.08,19.32 A1.65,1.65 0 0 0 14.08,20.83 L14.08,21 A2,2 0 1 1 10.08,21 L10.08,20.91 A1.65,1.65 0 0 0 9,19.4 A1.65,1.65 0 0 0 7.18,19.73 L7.12,19.79 A2,2 0 1 1 4.29,16.96 L4.35,16.9 A1.65,1.65 0 0 0 4.68,15.08 A1.65,1.65 0 0 0 3.17,14.08 L3,14.08 A2,2 0 1 1 3,10.08 L3.09,10.08 A1.65,1.65 0 0 0 4.6,9 A1.65,1.65 0 0 0 4.27,7.18 L4.21,7.12 A2,2 0 1 1 7.04,4.29 L7.1,4.35 A1.65,1.65 0 0 0 8.92,4.68 L9,4.68 A1.65,1.65 0 0 0 10,3.17 L10,3 A2,2 0 1 1 14,3 L14,3.09 A1.65,1.65 0 0 0 15,4.6 A1.65,1.65 0 0 0 16.82,4.27 L16.88,4.21 A2,2 0 1 1 19.71,7.04 L19.65,7.1 A1.65,1.65 0 0 0 19.32,8.92 L19.32,9 A1.65,1.65 0 0 0 20.83,10 L21,10 A2,2 0 1 1 21,14 L20.91,14 A1.65,1.65 0 0 0 19.4,15 Z"/>
       <TextBlock Text="الإعدادات ومفاتيح API" VerticalAlignment="Center"/>
      </StackPanel>
     </RadioButton>
    </StackPanel>

    <Border/>
   </DockPanel>
  </Border>

  <!-- ==================== MAIN STUDIO WORKSPACE ==================== -->
  <Grid Grid.Column="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <!-- Persistent Project Command Bar (Visible whenever a project is open & not on Library) -->
   <Border x:Name="ProjectCommandBar" Grid.Row="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="22,12" Visibility="Collapsed">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>

     <!-- Right: Game Title & Engine Pill -->
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,22,0" MaxWidth="340">
      <WrapPanel VerticalAlignment="Center">
       <TextBlock x:Name="DashboardName" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="235" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentIndicator}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
        <TextBlock x:Name="EngineSummary" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}"/>
       </Border>
      </WrapPanel>
      <TextBlock x:Name="ScanSummary" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
      <TextBlock x:Name="DeploymentSummary" Visibility="Collapsed"/>
      <TextBlock x:Name="OutputSummary" Visibility="Collapsed"/>
      <TextBlock x:Name="OverviewTeam" Visibility="Collapsed"/>
     </StackPanel>

     <!-- Center: Progress Bar & Clickable Quick Filter Pills -->
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,20,0" MaxWidth="540" HorizontalAlignment="Stretch">
      <Grid Margin="0,0,0,5">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" Text="تقدّم التعريب" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}"/>
       <TextBlock Grid.Column="1" x:Name="ApprovalPercent" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentIndicator}"/>
      </Grid>
      <ProgressBar x:Name="ApprovalProgress" Height="7" Margin="0,0,0,8" AutomationProperties.Name="نسبة الاعتماد"/>
      <WrapPanel>
       <Button x:Name="PendingCount" Tag="pending" Click="OpenStatus" Style="{StaticResource StatusPillButtonStyle}"/>
       <Button x:Name="DraftCount" Tag="review" Click="OpenStatus" Style="{StaticResource StatusPillButtonStyle}" Background="{DynamicResource WarningBg}" Foreground="{DynamicResource WarningFg}"/>
       <Button x:Name="IssueCount" Tag="issues" Click="OpenStatus" Style="{StaticResource StatusPillButtonStyle}" Background="{DynamicResource DangerBg}" Foreground="{DynamicResource DangerFg}"/>
       <Button x:Name="ApprovedCount" Tag="approved" Click="OpenStatus" Style="{StaticResource StatusPillButtonStyle}" Background="{DynamicResource SuccessBg}" Foreground="{DynamicResource SuccessFg}" Margin="0"/>
      </WrapPanel>
     </StackPanel>

     <!-- Left: Single Cross-Stage CTA + Stop Button -->
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="DashboardTrial" Content="جرّب اللعبة" Click="TryGame" Visibility="Collapsed" Padding="13,8"/>
      <Button x:Name="DashboardPreview" Content="بناء معاينة" Click="PreviewFromProject" Visibility="Collapsed"/>
      <Button x:Name="OpenLatest" Content="فتح الناتج" Click="OpenOutput" Visibility="Collapsed"/>
      <Button x:Name="Primary" Click="PrimaryAction" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/>
      <Button x:Name="HeaderCancelButton" Content="إيقاف العملية" Click="CancelWork" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding Visibility, ElementName=Busy}" Margin="0"/>
     </StackPanel>
    </Grid>
   </Border>

   <!-- Stage Host (Hidden Tab Headers, Synced with Sidebar Rail) -->
   <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="NavigateWorkspace" Background="Transparent" BorderThickness="0" Padding="0">
    <TabControl.ItemContainerStyle>
     <Style TargetType="TabItem">
      <Setter Property="Visibility" Value="Collapsed"/>
     </Style>
    </TabControl.ItemContainerStyle>

    <!-- ==================== VIEW 0: LIBRARY & START ==================== -->
    <TabItem x:Name="LibraryPage" Header="مكتبتي">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,22" MaxWidth="1440" HorizontalAlignment="Stretch">

       <!-- Interactive Drop Zone Hero Card -->
       <Border x:Name="DropZoneBorder" Style="{StaticResource CardBorderStyle}" Padding="26,24" AllowDrop="True" PreviewDragOver="SourceDragOver" DragLeave="SourceDragLeave" Drop="DropSource">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
          <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentIndicator}" BorderThickness="1" CornerRadius="6" Padding="9,3" HorizontalAlignment="Left" Margin="0,0,0,10">
           <TextBlock Text="استوديو تعريب الألعاب الذكي" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}"/>
          </Border>
          <TextBlock Text="ابدأ مشروع تعريب جديد" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="اختر لعبتك المثبّتة من مكتبة Steam بضغطة واحدة، أو اسحب مجلد اللعبة أو ملف اللغة وأفلته هنا مباشرة." Foreground="{DynamicResource TextSecondary}" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,18"/>
          <WrapPanel>
           <Button Content="اختيار من مكتبة Steam" Click="StartSteamSource" Style="{StaticResource PrimaryButtonStyle}"/>
           <Button Content="اختيار مجلد لعبة" Click="StartGame"/>
           <Button Content="فتح ملف منفرد" Click="StartFile"/>
           <Button Content="مجلد حفظ المشاريع" Click="ChooseWorkspace" Style="{StaticResource GhostButtonStyle}"/>
          </WrapPanel>
         </StackPanel>
         <Border Grid.Column="1" Width="116" Height="104" CornerRadius="14" Background="{DynamicResource BgSubtle}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1.5" VerticalAlignment="Center">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
           <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,7">
            <Path Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentIndicator}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,17 L4,19 C4,20.1 4.9,21 6,21 L18,21 C19.1,21 20,20.1 20,19 L20,17"/>
           </Border>
           <TextBlock Text="إفلات سريع" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
          </StackPanel>
         </Border>
        </Grid>
       </Border>

       <!-- Rich Recent Projects Section -->
       <Grid Margin="2,24,2,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="مشاريعك الأخيرة" FontSize="17.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
        <TextBlock Grid.Column="1" x:Name="RecentEmptyHint" Text="لا توجد مشاريع سابقة بعد — ابدأ باختيار لعبة من الأعلى." FontSize="12.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Visibility="Collapsed"/>
       </Grid>

       <ListBox x:Name="RecentProjects" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OpenRecent" KeyDown="RecentKey" AutomationProperties.Name="المشاريع الأخيرة">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Border Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,4">
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="*"/>
             <ColumnDefinition Width="250"/>
             <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
             <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
              <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="5" Padding="8,1.5" VerticalAlignment="Center">
               <TextBlock Text="{Binding EngineBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}"/>
              </Border>
             </WrapPanel>
             <TextBlock Text="{Binding SourceDisplay}" FlowDirection="LeftToRight" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Path}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
             <TextBlock Text="{Binding StatsText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
             <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="6"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
             <Button Content="فتح المشروع ←" Tag="{Binding Path}" Click="OpenRecentCardClick" Padding="14,8" Margin="0,0,6,0"/>
             <Button Tag="{Binding Path}" Click="RemoveRecentCardClick" Style="{StaticResource GhostButtonStyle}" Width="32" Height="32" Padding="0" Margin="0" ToolTip="إزالة من القائمة الأخيرة">
              <Path Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L10,10 M10,2 L2,10"/>
             </Button>
            </StackPanel>
           </Grid>
          </Border>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </ScrollViewer>
    </TabItem>

    <!-- ==================== STAGE 1: SOURCE & SMART FILE GUARD ==================== -->
    <TabItem x:Name="FilesPage" Header="المصدر والملفات" IsEnabled="False">
     <Grid Margin="22,16">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Source Bar & Pre-Translation File Guard Banner -->
      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,14">
       <StackPanel>
        <Grid Margin="0,0,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0" Margin="0,0,12,0">
          <TextBlock Text="مصدر ملفات اللعبة وفحص النصوص" FontSize="17" FontWeight="Bold"/>
          <TextBlock Text="يفحص Locara ملفات اللعبة تلقائياً ويعزل الملفات البرمجية واللغات الإضافية لحماية اللعبة ورصيدك." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ScanFilesPrimaryBtn" Content="إعادة فحص الملفات" Click="Scan"/>
          <Button Content="تغيير المجلد" Click="ChooseFolder"/>
          <Button Content="ملف / حزمة" Click="ChooseFile"/>
          <Button x:Name="LanguageButton" Content="لغة المصدر" Click="ChooseLanguage"/>
          <Button x:Name="RenpyGenerateButton" Content="توليد قوالب Ren’Py" Click="GenerateRenpy" Visibility="Collapsed"/>
         </StackPanel>
        </Grid>

        <TextBox x:Name="SourcePath" FlowDirection="LeftToRight" FontFamily="{StaticResource MonoFont}" FontSize="12" IsReadOnly="True"/>

        <!-- Pre-Translation File Quality Guard Banner -->
        <Border x:Name="FilesGuardBanner" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,10,0,0" Visibility="Collapsed">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
           <TextBlock x:Name="FilesGuardTitle" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" TextWrapping="Wrap"/>
           <TextBlock x:Name="FilesGuardDetail" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="ContinueToBotsBtn" Content="المتابعة إلى غرفة البوتات ←" Click="GoTranslation" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Margin="0"/>
         </Grid>
        </Border>
       </StackPanel>
      </Border>

      <!-- Advanced Source Options (Collapsed unless needed / AES required) -->
      <Expander x:Name="SourceAdvancedExpander" Grid.Row="1" Header="خيارات المصدر المتقدمة (مفتاح Unreal AES · كلمة مرور ZIP · اختيار الحزم وضبط الحقول)">
       <StackPanel>
        <WrapPanel Margin="0,0,0,6">
         <TextBlock Text="المحرّك:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
         <ComboBox x:Name="Engine" Width="135" SelectedIndex="0" Margin="0,0,14,0">
          <ComboBoxItem Content="auto"/>
          <ComboBoxItem Content="generic"/>
          <ComboBoxItem Content="godot"/>
          <ComboBoxItem Content="rpgmaker"/>
          <ComboBoxItem Content="renpy"/>
          <ComboBoxItem Content="unity"/>
          <ComboBoxItem Content="unreal"/>
          <ComboBoxItem Content="gamemaker"/>
         </ComboBox>
         <TextBlock Text="كلمة مرور ZIP:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
         <PasswordBox x:Name="ZipPassword" Width="145" Margin="0,0,14,0"/>
         <TextBlock Text="مفتاح Unreal AES:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
         <TextBox x:Name="UnrealAesKey" Width="220" FlowDirection="LeftToRight" FontFamily="{StaticResource MonoFont}" Margin="0,0,10,0" ToolTip="اختياري لحزم Unreal المشفّرة (64 حرف Hex بصيغة 0x... أو Base64)"/>
         <Button Content="ضبط حقول الاستخراج" Click="ConfigureExtraction"/>
         <Button Content="فحص القدرات" Click="ShowCapabilities"/>
        </WrapPanel>
        <WrapPanel>
         <Button Content="اكتشاف الحزم الفرعية" Click="FindPackages"/>
         <ComboBox x:Name="PackageChoices" MinWidth="320" MaxWidth="620" DisplayMemberPath="Label" Margin="0,0,8,0"/>
         <Button Content="اعتماد الحزمة المحددة" Click="UsePackage"/>
        </WrapPanel>
       </StackPanel>
      </Expander>

      <!-- Scanned Files Table + Live Sample Preview -->
      <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,8,0,0">
       <Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0">
          <TextBlock Text="ملفات النصوص المكتشفة" FontSize="15.5" FontWeight="SemiBold"/>
          <TextBlock x:Name="FilesSelectionSummary" Text="اضغط «إعادة فحص الملفات» لاستعراض الملفات ومعاينة نصوصها." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
         </StackPanel>
         <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="RunAiScoutButton" Content="تحليل ذكي (AI Scout)" Click="RunAiScout" FontSize="12" Padding="11,6" ToolTip="يحلّل الملفات المختلطة ويقترح حقول النصوص البشرية بدقة"/>
          <Button Content="الموصى به فقط" Click="SelectRecommendedScannedFiles" FontSize="12" Padding="11,6"/>
          <Button Content="تحديد الكل" Click="SelectAllScannedFiles" FontSize="12" Padding="10,6"/>
          <Button Content="إلغاء الكل" Click="DeselectAllScannedFiles" FontSize="12" Padding="10,6" Margin="0"/>
         </WrapPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="200"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="بحث:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
         <TextBox Grid.Column="1" x:Name="FilesSearchBox" FontSize="12" FlowDirection="LeftToRight" TextChanged="FilterScannedFilesChanged" Margin="0,0,14,0" ToolTip="ابحث باسم الملف أو الصيغة أو جزء من العينة"/>
         <TextBlock Grid.Column="2" Text="التصنيف:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
         <ComboBox Grid.Column="3" x:Name="FilesVerdictFilter" FontSize="12" SelectionChanged="FilterScannedFilesChanged" SelectedIndex="0">
          <ComboBoxItem Content="الكل" Tag="all"/>
          <ComboBoxItem Content="المفعّل للترجمة فقط" Tag="included"/>
          <ComboBoxItem Content="قابل للترجمة" Tag="translatable"/>
          <ComboBoxItem Content="مختلط — راجع العينة" Tag="mixed"/>
          <ComboBoxItem Content="بيانات جانبية" Tag="auxiliary"/>
          <ComboBoxItem Content="لغة إضافية" Tag="secondary"/>
          <ComboBoxItem Content="تقني / برمجي" Tag="technical"/>
         </ComboBox>
        </Grid>

        <DataGrid Grid.Row="2" x:Name="ScannedFilesGrid" MinHeight="180" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" RowHeight="38" FontSize="12.5" SelectionChanged="SelectScannedFileRow">
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="تضمين" Width="62">
           <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
             <CheckBox IsChecked="{Binding Included, Mode=OneWay}" Click="ToggleScannedFile" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
            </DataTemplate>
           </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="الملف" Binding="{Binding Path}" IsReadOnly="True" Width="1.5*">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="FlowDirection" Value="LeftToRight"/>
             <Setter Property="VerticalAlignment" Value="Center"/>
             <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
             <Setter Property="ToolTip" Value="{Binding Path}"/>
             <Setter Property="Padding" Value="8,0"/>
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="الصيغة" Binding="{Binding Format}" IsReadOnly="True" Width="88">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="FlowDirection" Value="LeftToRight"/>
             <Setter Property="VerticalAlignment" Value="Center"/>
             <Setter Property="HorizontalAlignment" Value="Center"/>
             <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
             <Setter Property="FontSize" Value="11.5"/>
             <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="النصوص" Binding="{Binding UnitsSummary}" IsReadOnly="True" Width="130">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="VerticalAlignment" Value="Center"/>
             <Setter Property="Padding" Value="8,0"/>
             <Setter Property="FontWeight" Value="Medium"/>
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="التصنيف الذكي" IsReadOnly="True" Width="162">
           <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
             <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,2.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0" ToolTip="{Binding Reason}">
              <TextBlock Text="{Binding VerdictLabel}" Foreground="{Binding VerdictBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
             </Border>
            </DataTemplate>
           </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="عينة سريعة" Binding="{Binding SamplesPreview}" IsReadOnly="True" Width="2*">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="FlowDirection" Value="LeftToRight"/>
             <Setter Property="VerticalAlignment" Value="Center"/>
             <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
             <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
             <Setter Property="ToolTip" Value="{Binding SamplesPreview}"/>
             <Setter Property="Padding" Value="8,0"/>
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
         </DataGrid.Columns>
        </DataGrid>

        <!-- Selected File Sample Preview -->
        <Border Grid.Row="3" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,8,0,0">
         <StackPanel>
          <Grid Margin="0,0,0,3">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" x:Name="SelectedFilePathText" Text="اختر ملفاً من الجدول أعلاه لمعاينة أول 5 نصوص فيه قبل الترجمة." FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
           <Button Grid.Column="1" x:Name="IncludeHumanOnlyButton" Content="تفعيل النصوص البشرية فقط في هذا الملف" Click="IncludeHumanOnlySelectedFile" Visibility="Collapsed" FontSize="11.5" Padding="10,4" Margin="0"/>
          </Grid>
          <TextBlock x:Name="SelectedFileReasonText" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,4"/>
          <TextBox x:Name="SelectedFileSamplesText" FlowDirection="LeftToRight" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="{DynamicResource TextSecondary}" MaxHeight="84" VerticalScrollBarVisibility="Auto" Padding="0"/>
         </StackPanel>
        </Border>
       </Grid>
      </Border>

      <Expander x:Name="ScanLogExpander" Grid.Row="3" Header="سجل الفحص والتشخيصات التقنية" IsExpanded="False" Margin="0,6,0,0">
       <TextBox x:Name="ScanLog" Height="84" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
      </Expander>
     </Grid>
    </TabItem>

    <!-- ==================== STAGE 2: LIVE 3-BOT STUDIO ==================== -->
    <TabItem x:Name="TranslationPage" Header="البوتات والترجمة" IsEnabled="False">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,16" MaxWidth="1480" HorizontalAlignment="Stretch">

       <!-- Top Launch & Mode Card (Edge-to-Edge Balanced Controls) -->
       <Border Style="{StaticResource CardBorderStyle}" Padding="18,14">
        <StackPanel>
         <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,14,0">
           <TextBlock Text="غرفة البوتات الذكية المترابطة" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
           <TextBlock x:Name="TranslationFilesGuardText" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
           <Button x:Name="ProviderSummaryBtn" Click="ToggleConnectionPanel" Padding="12,7" ToolTip="انقر لضبط اتصال الـ API والنموذج">
            <TextBlock x:Name="ProviderSummary" FontSize="12" Foreground="{DynamicResource AccentIndicator}" FontWeight="SemiBold" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
           </Button>
           <Button Click="ToggleRoutingPanel" Style="{StaticResource GhostButtonStyle}" Margin="0" Padding="11,7">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
             <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                   Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M9,4 L9,8 M15,10 L15,14 M11,16 L11,20"/>
             <TextBlock Text="توجيه البوتات" VerticalAlignment="Center"/>
            </StackPanel>
           </Button>
          </StackPanel>
         </Grid>

         <StackPanel x:Name="TranslationControlsPanel">
          <Grid Margin="0,2,0,10">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="0.72*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="0.78*"/>
           </Grid.ColumnDefinitions>
           <StackPanel Grid.Column="0">
            <TextBlock Text="النطاق المستهدف" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <ComboBox x:Name="TranslationMode" SelectedIndex="0" SelectedValuePath="Tag">
             <ComboBoxItem Content="كل النصوص المتبقية في المشروع" Tag="all-pending"/>
             <ComboBoxItem Content="مراجعة المسودات بالذكاء الاصطناعي" Tag="review-drafts"/>
             <ComboBoxItem Content="النطاق المفلتر حالياً في المحرّر" Tag="editor-scope"/>
            </ComboBox>
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="نظام التشغيل" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <ComboBox x:Name="SpeedMode" SelectedIndex="0" SelectedValuePath="Tag">
             <ComboBoxItem Content="بوتات ذكية مترابطة (موصى به — سياق + مسرد حي)" Tag="smart"/>
             <ComboBoxItem Content="مراجعة شاملة (مترجم + مدقق لكل سطر)" Tag="team"/>
             <ComboBoxItem Content="وضع سريع (ترجمة متسلسلة + فحص محلي)" Tag="fast"/>
            </ComboBox>
           </StackPanel>
           <StackPanel Grid.Column="4">
            <TextBlock Text="البوتات المتوازية" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <ComboBox x:Name="WorkersCount" SelectedIndex="2" SelectedValuePath="Tag" SelectionChanged="WorkersCountChanged">
             <ComboBoxItem Content="1 بوت" Tag="1"/>
             <ComboBoxItem Content="2 بوتان" Tag="2"/>
             <ComboBoxItem Content="4 بوتات (موصى)" Tag="4"/>
             <ComboBoxItem Content="6 بوتات" Tag="6"/>
             <ComboBoxItem Content="8 بوتات" Tag="8"/>
             <ComboBoxItem Content="12 بوتاً (سريع)" Tag="12"/>
             <ComboBoxItem Content="16 بوتاً (أقصى)" Tag="16"/>
            </ComboBox>
           </StackPanel>
           <StackPanel Grid.Column="6">
            <TextBlock Text="حجم الدفعة" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <ComboBox x:Name="BatchSizeChoice" SelectedIndex="1" SelectedValuePath="Tag">
             <ComboBoxItem Content="15 نصاً / دفعة" Tag="15"/>
             <ComboBoxItem Content="30 نصاً / دفعة (موصى)" Tag="30"/>
             <ComboBoxItem Content="45 نصاً / دفعة" Tag="45"/>
             <ComboBoxItem Content="60 نصاً / دفعة" Tag="60"/>
            </ComboBox>
           </StackPanel>
          </Grid>

          <Grid Margin="0,2,0,10">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel Grid.Column="0">
            <CheckBox x:Name="AutoApproveReviewed" IsChecked="True" Content="اعتماد الترجمات المدققة تلقائياً فور حفظها"/>
            <CheckBox x:Name="UseSharedMemoryPrefill" IsChecked="True" Checked="UseSharedMemoryPrefillChanged" Unchecked="UseSharedMemoryPrefillChanged" Content="تعبئة تلقائية من الذاكرة المشتركة (100%) قبل تشغيل البوتات لتوفير التوكنز" Margin="0,5,0,0"/>
           </StackPanel>
           <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock x:Name="SharedMemoryBadge" Text="" FontSize="11.5" Foreground="{DynamicResource AccentIndicator}" HorizontalAlignment="Right" Visibility="Collapsed"/>
            <TextBlock x:Name="BudgetCapBadge" Text="" FontSize="12" Foreground="{DynamicResource WarningFg}" HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,2,0,0"/>
           </StackPanel>
           <TextBlock x:Name="ScopeSummary" Visibility="Collapsed"/>
          </Grid>

          <WrapPanel>
           <Button x:Name="ResumeTeamPrimary" Content="استأنف الجلسة المحفوظة" Click="ResumeTeamQuick" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"/>
           <Button x:Name="StartTranslationPrimary" Content="تشغيل البوتات الآن" Click="StartUnifiedTranslation" Style="{StaticResource PrimaryButtonStyle}"/>
           <Button Content="تجربة 3 نصوص" Click="TranslateSample"/>
           <Button x:Name="ApproveTeamDraftsButton" Content="اعتماد المسودات السليمة" Click="ApproveAllDrafts" Visibility="Collapsed"/>
           <Button Content="مراجعة الملفات المشمولة" Click="GoFiles" Style="{StaticResource GhostButtonStyle}"/>
          </WrapPanel>
         </StackPanel>
        </StackPanel>
       </Border>

       <!-- Interactive 3-Bot Pipeline Telemetry Card -->
       <Border x:Name="LiveMonitorCard" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,10,0,0">
        <StackPanel>
         <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <TextBlock x:Name="LiveMonitorTitle" Text="خلية البوتات وحالة الجلسة" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
           <TextBlock x:Name="SavedTeamSummary" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
           <Button x:Name="BotGlossaryAuditBtn" Content="فحص اتّساق المعجم" Click="RunGlossaryAuditClick" ToolTip="اكتشاف السطور المترجمة التي خالفت مصطلحاً مثبّتاً في معجمك اليدوي"/>
           <Button x:Name="TeamNotesButton" Content="ملاحظات المدقق" Click="ShowTeamNotes"/>
           <Button Content="ملف السجل (Log)" Click="OpenLiveLog" Style="{StaticResource GhostButtonStyle}"/>
           <Button x:Name="StopTranslationButton" Content="إيقاف مؤقت آمن" Click="CancelWork" Style="{StaticResource DangerButtonStyle}" Visibility="Collapsed" Margin="0"/>
          </StackPanel>
         </Grid>

         <!-- Post-Translation Glossary Consistency Banner (Bot Studio) -->
         <Border x:Name="BotGlossaryAuditBanner" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningFg}" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="BotGlossaryAuditTitle" FontWeight="Bold" Foreground="{DynamicResource WarningFg}" TextWrapping="Wrap"/>
            <TextBlock x:Name="BotGlossaryAuditDetail" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
           </StackPanel>
           <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <Button Content="عرض في المحرّر" Click="FilterGlossaryViolationsClick" Padding="10,5" FontSize="12"/>
            <Button x:Name="BotGlossaryExactFixBtn" Content="تحديث المطابقات التامة" Click="ApplyExactGlossaryFixesClick" Padding="10,5" FontSize="12" Visibility="Collapsed"/>
            <Button Content="إعادة تدقيق بالبوت" Click="RetranslateGlossaryViolationsClick" Padding="10,5" FontSize="12"/>
            <Button Content="✕" Click="DismissBotGlossaryBannerClick" Style="{StaticResource GhostButtonStyle}" Padding="7,4" FontSize="12" Margin="0"/>
           </WrapPanel>
          </Grid>
         </Border>

         <!-- 3 Specialized Bot Cards -->
         <UniformGrid Columns="3" Margin="0,0,0,10">
          <!-- Bot 1: Lore & Glossary Bot -->
          <Border x:Name="LoreBotCard" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="OpenLoreSubTabClick" ToolTip="انقر لعرض بطاقة عالم اللعبة والمسرد المكتشف">
           <StackPanel>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="1" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentIndicator}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
             </Border>
             <TextBlock Grid.Column="1" Text="بوت الكشّاف والعالم" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
             <TextBlock Grid.Column="2" x:Name="LoreBotBadge" Text="في الانتظار" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="LoreBotDetail" Text="يبني بطاقة عالم اللعبة ويكتشف الأسماء والمصطلحات تلقائياً" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
           </StackPanel>
          </Border>

          <!-- Bot 2: Stateful Scene Translators -->
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="3,0">
           <StackPanel>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="2" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentIndicator}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
             </Border>
             <TextBlock Grid.Column="1" Text="بوتات المشاهد المتسلسلة" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
             <TextBlock Grid.Column="2" x:Name="LiveActiveAgentsText" Text="0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentIndicator}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="جلسات محادثة متصلة بذاكرة سياق متحركة ومشاركة مصطلحات حية" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
           </StackPanel>
          </Border>

          <!-- Bot 3: Smart Contextual QA Bot -->
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="6,0,0,0">
           <StackPanel>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="3" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentIndicator}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
             </Border>
             <TextBlock Grid.Column="1" Text="بوت المدقق السياقي" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
             <TextBlock Grid.Column="2" x:Name="LiveModeBadge" Text="في وضع الانتظار" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="LiveNotesCountText" Text="يتخطّى الأزرار السليمة ويركّز على تدقيق الحوارات والسرد" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
           </StackPanel>
          </Border>
         </UniformGrid>

         <!-- Progress & 4 KPI Metrics -->
         <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="LiveProgressText" Text="جاهز للتشغيل" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}"/>
          <TextBlock Grid.Column="1" x:Name="LiveEtaText" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
         </Grid>
         <ProgressBar x:Name="LiveProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"/>

         <UniformGrid Columns="4" Margin="0,10,0,10">
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="0,0,5,0">
           <StackPanel>
            <TextBlock Text="التوكنز (الجلسة)" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="LiveTokensTotal" Text="0" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/>
            <TextBlock x:Name="LiveTokensBreakdown" Text="دخل: 0 · خرج: 0" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </Border>
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="3,0">
           <StackPanel>
            <TextBlock Text="السرعة والطلبات" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="LiveSpeedText" Text="—" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/>
            <TextBlock x:Name="LiveRequestsText" Text="0 طلب" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
           </StackPanel>
          </Border>
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="3,0">
           <StackPanel>
            <TextBlock Text="الترجمات المحفوظة" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="LiveSavedText" Text="0" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SuccessFg}" Margin="0,3,0,0"/>
            <TextBlock Text="تُحفظ أولاً بأول في المشروع" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
           </StackPanel>
          </Border>
          <Border x:Name="OverviewUsageCard" Style="{StaticResource SubtleCardBorderStyle}" Margin="5,0,0,0" Cursor="Hand" MouseLeftButtonUp="OpenUsagePanel" ToolTip="انقر لفتح سجل الاستهلاك وأسعار النماذج">
           <StackPanel>
            <TextBlock Text="تكلفة المشروع التراكمية" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="OverviewTotalCost" Text="$0.00" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentIndicator}" Margin="0,3,0,0"/>
            <TextBlock x:Name="OverviewTotalRequests" Text="0 طلب مسجّل" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="OverviewTotalTokens" Visibility="Collapsed"/>
            <TextBlock x:Name="OverviewTokensBreakdown" Visibility="Collapsed"/>
           </StackPanel>
          </Border>
         </UniformGrid>

         <!-- Segmented Sub-View Switcher (Left in RTL = Physical Right!) -->
         <Border Background="{DynamicResource BgSubtle}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="9" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,12">
          <WrapPanel>
           <RadioButton x:Name="BotTabLive" GroupName="BotSubTabs" Style="{StaticResource SegmentedRadioStyle}" IsChecked="True" Checked="BotSubTabChanged" Content="البث الحي ومسارات البوتات"/>
           <RadioButton x:Name="BotTabLore" GroupName="BotSubTabs" Style="{StaticResource SegmentedRadioStyle}" Checked="BotSubTabChanged" Content="عالم اللعبة والمسرد الحي"/>
           <RadioButton x:Name="BotTabSections" GroupName="BotSubTabs" Style="{StaticResource SegmentedRadioStyle}" Checked="BotSubTabChanged" Content="تقدّم الملفات والأقسام"/>
          </WrapPanel>
         </Border>

         <!-- SUB-VIEW 1: Live Lanes + Live Translated Stream -->
         <Grid x:Name="BotLiveSubPanel">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="1.3*"/>
           <ColumnDefinition Width="14"/>
           <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
           <TextBlock Text="مسارات البوتات النشطة" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
           <Grid MinHeight="210">
            <DataGrid x:Name="AgentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="34" MinHeight="210" MaxHeight="260" FontSize="12.5">
             <DataGrid.Columns>
              <DataGridTextColumn Header="البوت" Binding="{Binding AgentName}" Width="88">
               <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="6,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
               </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="118">
               <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="6,0"/></Style>
               </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="النموذج" Binding="{Binding ModelLabel}" Width="145">
               <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                 <Setter Property="FlowDirection" Value="LeftToRight"/>
                 <Setter Property="VerticalAlignment" Value="Center"/>
                 <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                 <Setter Property="Foreground" Value="{DynamicResource AccentIndicator}"/>
                 <Setter Property="Padding" Value="6,0"/>
                </Style>
               </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="الحالة" Binding="{Binding Stage}" Width="76">
               <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="6,0"/></Style>
               </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="دفعة" Binding="{Binding BatchLabel}" Width="58">
               <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
               </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="منجز" Binding="{Binding CompletedCount}" Width="58">
               <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
               </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="التفاصيل" Binding="{Binding Detail}" Width="*">
               <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Padding" Value="6,0"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></Style>
               </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
             </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="اضغط «تشغيل البوتات الآن» لمتابعة مسارات البوتات النشطة هنا لحظياً." FontSize="12.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,34,18,0" IsHitTestVisible="False">
             <TextBlock.Style>
              <Style TargetType="TextBlock">
               <Setter Property="Visibility" Value="Collapsed"/>
               <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, ElementName=AgentsGrid}" Value="False">
                 <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </TextBlock.Style>
            </TextBlock>
           </Grid>

           <Expander x:Name="ActivityFeedExpander" Header="سجل أحداث البوتات المباشر" IsExpanded="False" Margin="0,10,0,0">
            <ListBox x:Name="ActivityLog" MaxHeight="140" BorderThickness="0" FontSize="11.5"/>
           </Expander>
          </StackPanel>

          <Border Grid.Column="2" Style="{StaticResource SubtleCardBorderStyle}" Padding="14,12" MinHeight="210" VerticalAlignment="Stretch">
           <StackPanel>
            <TextBlock Text="آخر النصوص المعرّبة حياً" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentIndicator}" Margin="0,0,0,6"/>
            <TextBlock x:Name="LiveSamplesEmptyText" Text="ستظهر هنا عينات حية من جمل اللعبة فور تعريبها أثناء عمل البوتات." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6"/>
            <ItemsControl x:Name="LiveTranslationFeed" MaxHeight="260">
             <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
               <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
               </ScrollViewer>
              </ControlTemplate>
             </ItemsControl.Template>
             <ItemsControl.ItemTemplate>
              <DataTemplate>
               <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,6">
                <StackPanel>
                 <TextBlock Text="{Binding Section}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                 <TextBlock Text="{Binding Source}" FlowDirection="LeftToRight" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,3"/>
                 <TextBlock Text="{Binding Target}" FlowDirection="RightToLeft" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
               </Border>
              </DataTemplate>
             </ItemsControl.ItemTemplate>
            </ItemsControl>
           </StackPanel>
          </Border>
         </Grid>

         <!-- SUB-VIEW 2: World Brief + Bot Glossary + Manual Glossary -->
         <StackPanel x:Name="BotLoreSubPanel" Visibility="Collapsed">
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="0,0,0,10">
           <StackPanel>
            <TextBlock Text="بطاقة عالم اللعبة والشخصيات (من بوت الكشّاف)" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AccentIndicator}" Margin="0,0,0,4"/>
            <TextBlock x:Name="WorldBriefText" Text="تُبنى بطاقة عالم اللعبة تلقائياً عند بدء تشغيل البوتات لتوحيد النبرة وأسماء الشخصيات عبر كل المشاهد." FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
           </StackPanel>
          </Border>

          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
           </Grid.ColumnDefinitions>

           <!-- Bot Auto-Discovered Glossary -->
           <Border Grid.Column="0" Style="{StaticResource SubtleCardBorderStyle}">
            <StackPanel>
             <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="مصطلحات مكتشفة تلقائياً (ذاكرة البوتات)" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Grid.Column="1" x:Name="ClearBotTermsBtn" Content="مسح التلقائي" Click="ClearBotGlossaryClick" Style="{StaticResource GhostButtonStyle}" FontSize="11.5" Padding="8,3" Margin="0"/>
             </Grid>
             <TextBlock x:Name="BotTermsEmptyText" Text="لم تُسجّل مصطلحات تلقائية بعد — يكتشفها بوت الكشّاف وبوتات المشاهد أثناء الترجمة." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
             <ListBox x:Name="BotTermsList" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
               <DataTemplate>
                <Grid>
                 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                 <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                  <WrapPanel>
                   <TextBlock Text="{Binding Source}" FlowDirection="LeftToRight" FontWeight="SemiBold" Margin="0,0,8,0"/>
                   <TextBlock Text="←" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                   <TextBlock Text="{Binding Target}" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" Margin="0,0,8,0"/>
                   <TextBlock Text="{Binding OriginLabel}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                  </WrapPanel>
                 </StackPanel>
                 <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="★ تثبيت" Tag="{Binding Source}" IsEnabled="{Binding CanMutate}" Click="PromoteBotTermClick" FontSize="11" Padding="8,3" ToolTip="ترقية المصطلح إلى معجمك اليدوي المعتمد"/>
                  <Button Content="✕" Tag="{Binding Source}" IsEnabled="{Binding CanMutate}" Click="RemoveBotTermClick" Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="6,3" Margin="0"/>
                 </StackPanel>
                </Grid>
               </DataTemplate>
              </ListBox.ItemTemplate>
             </ListBox>
            </StackPanel>
           </Border>

           <!-- Authoritative Manual Glossary -->
           <Border x:Name="GlossaryPanel" Grid.Column="2" Style="{StaticResource SubtleCardBorderStyle}">
            <StackPanel>
             <TextBlock Text="معجمك اليدوي المعتمد (الأولوية القصوى)" FontWeight="SemiBold" Margin="0,0,0,6"/>
             <ListBox x:Name="Terms" SelectionChanged="OpenTerm" MinHeight="100" MaxHeight="145" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
               <DataTemplate>
                <WrapPanel>
                 <TextBlock Text="{Binding Key}" FlowDirection="LeftToRight" FontWeight="SemiBold" Margin="0,0,8,0"/>
                 <TextBlock Text="←" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                 <TextBlock Text="{Binding Value}" Foreground="{DynamicResource SuccessFg}" FontWeight="SemiBold"/>
                </WrapPanel>
               </DataTemplate>
              </ListBox.ItemTemplate>
             </ListBox>
             <StackPanel x:Name="GlossaryEditControls">
              <UniformGrid Columns="2" Margin="0,0,0,6">
               <StackPanel Margin="0,0,4,0">
                <TextBlock Text="المصطلح الإنجليزي" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="TermSource" FlowDirection="LeftToRight"/>
               </StackPanel>
               <StackPanel Margin="4,0,0,0">
                <TextBlock Text="الترجمة المعتمدة" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="TermTarget"/>
               </StackPanel>
              </UniformGrid>
              <WrapPanel>
               <Button Content="حفظ في المعجم" Click="SaveTerm"/>
               <Button Content="فحص اتّساق المعجم" Click="RunGlossaryAuditClick"/>
               <Button Content="حذف المحدد" Click="DeleteTerm" Style="{StaticResource GhostButtonStyle}"/>
                <Button Content="تصدير المعجم (JSON/CSV)" Click="ExportGlossaryClick"/>
                <Button Content="استيراد معجم" Click="ImportGlossaryClick"/>
              </WrapPanel>
             </StackPanel>
            </StackPanel>
           </Border>
          </Grid>
         </StackPanel>

         <!-- SUB-VIEW 3: Per-File Section Progress -->
         <Border x:Name="BotSectionsSubPanel" Style="{StaticResource SubtleCardBorderStyle}" Visibility="Collapsed">
          <StackPanel x:Name="SectionsPanel">
           <TextBlock Text="تقدّم الملفات والأقسام في الجلسة الحالية" FontWeight="SemiBold" Margin="0,0,0,6"/>
           <ListBox x:Name="SectionList" MaxHeight="240" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
          </StackPanel>
         </Border>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>

    <!-- ==================== STAGE 3: SPLIT CONTEXTUAL STUDIO EDITOR ==================== -->
    <TabItem x:Name="EditorPage" Header="المحرّر والمراجعة" IsEnabled="False">
     <Grid Margin="18,14">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top Action Strips (Drafts + Glossary Consistency Audit) -->
      <StackPanel Grid.Row="0">
       <Border x:Name="DraftsActionPanel" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningFg}" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="DraftsActionTitle" FontWeight="Bold" Foreground="{DynamicResource WarningFg}"/>
          <TextBlock Text="يمكنك تدقيق المسودات آلياً عبر البوت المدقق أو اعتماد السليمة منها بنقرة واحدة." FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
         </StackPanel>
         <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Content="تدقيق المسودات بالبوت المدقق" Click="ReviewDraftsWithAi"/>
          <Button Content="اعتماد كل السليمة دفعة واحدة" Click="ApproveAllDrafts" Margin="0"/>
         </WrapPanel>
        </Grid>
       </Border>

       <Border x:Name="GlossaryAuditBanner" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningFg}" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="GlossaryAuditBannerTitle" FontWeight="Bold" Foreground="{DynamicResource WarningFg}" TextWrapping="Wrap"/>
          <TextBlock x:Name="GlossaryAuditBannerDetail" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
         </StackPanel>
         <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="EditorGlossaryExactFixBtn" Content="تحديث المطابقات التامة" Click="ApplyExactGlossaryFixesClick" Visibility="Collapsed"/>
          <Button Content="إعادة تدقيق المخالفات بالبوت" Click="RetranslateGlossaryViolationsClick"/>
          <Button Content="إنهاء الفلتر" Click="ExitGlossaryFilterClick" Style="{StaticResource GhostButtonStyle}" Margin="0"/>
         </WrapPanel>
        </Grid>
       </Border>
      </StackPanel>

      <!-- Clean Search, Status Chips & Toolbar -->
      <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
         <TextBox x:Name="Search" Width="210" AutomationProperties.Name="بحث في النصوص" KeyDown="SearchKey" Margin="0,0,6,0" ToolTip="ابحث في النص الأصلي أو العربي أو مسار الملف (Ctrl+F)"/>
         <Button Content="بحث" Click="SearchRows" Padding="11,6" Margin="0,0,10,0"/>

         <!-- Hidden ComboBox preserved for code compatibility, synced with interactive chips -->
         <ComboBox x:Name="ReviewFilter" Visibility="Collapsed" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="ChangeReviewFilter">
          <ComboBoxItem Content="كل الحالات" Tag=""/>
          <ComboBoxItem Content="بانتظار الترجمة" Tag="pending"/>
          <ComboBoxItem Content="للمراجعة" Tag="review"/>
          <ComboBoxItem Content="تحتاج انتباهاً" Tag="issues"/>
          <ComboBoxItem Content="معتمدة" Tag="approved"/>
          <ComboBoxItem Content="المسودات" Tag="translated"/>
          <ComboBoxItem Content="التعارضات" Tag="conflict"/>
          <ComboBoxItem Content="مخالفات المعجم" Tag="glossary"/>
           <ComboBoxItem Content="تحذيرات الطول" Tag="length"/>
         </ComboBox>

         <RadioButton x:Name="EditorChipAll" GroupName="EditorFilterChips" Style="{StaticResource FilterChipRadioStyle}" Tag="" IsChecked="True" Click="EditorFilterChipClick" Content="الكل"/>
         <RadioButton x:Name="EditorChipPending" GroupName="EditorFilterChips" Style="{StaticResource FilterChipRadioStyle}" Tag="pending" Click="EditorFilterChipClick" Content="بانتظار الترجمة"/>
         <RadioButton x:Name="EditorChipReview" GroupName="EditorFilterChips" Style="{StaticResource FilterChipRadioStyle}" Tag="review" Click="EditorFilterChipClick" Content="للمراجعة"/>
         <RadioButton x:Name="EditorChipIssues" GroupName="EditorFilterChips" Style="{StaticResource FilterChipRadioStyle}" Tag="issues" Click="EditorFilterChipClick" Content="تنبيهات"/>
         <RadioButton x:Name="EditorChipApproved" GroupName="EditorFilterChips" Style="{StaticResource FilterChipRadioStyle}" Tag="approved" Click="EditorFilterChipClick" Content="معتمدة"/>
         <RadioButton x:Name="EditorChipGlossary" GroupName="EditorFilterChips" Style="{StaticResource FilterChipRadioStyle}" Tag="glossary" Click="EditorFilterChipClick" Content="مخالفات المعجم" Visibility="Collapsed"/>
          <RadioButton x:Name="EditorChipLength" GroupName="EditorFilterChips" Style="{StaticResource FilterChipRadioStyle}" Tag="length" Click="EditorFilterChipClick" Content="تحذيرات الطول" Visibility="Collapsed"/>
         <Button x:Name="EditorGlossaryAuditBtn" Content="فحص المعجم" Click="RunGlossaryAuditClick" Padding="10,5" FontSize="12" Margin="6,0,0,0" ToolTip="فحص اتّساق السطور المترجمة مع المعجم اليدوي"/>
        </WrapPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock x:Name="PageInfo" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <Button Content="◀ السابق" Click="Previous" Padding="10,5" FontSize="12"/>
         <Button Content="التالي ▶" Click="Next" Padding="10,5" FontSize="12"/>
         <Button x:Name="EditorTrial" Content="جرّب اللعبة" Click="TryGame" Visibility="Collapsed" Padding="10,5" FontSize="12"/>
         <Menu VerticalAlignment="Center">
          <MenuItem Header="أدوات المحرّر ▾" Padding="10,6">
           <MenuItem Header="فحص اتّساق المعجم اليدوي" Click="RunGlossaryAuditClick"/>
           <MenuItem Header="ترجمة الصفوف المحددة" Click="TranslateSelected"/>
           <MenuItem Header="اعتماد الصفحة الحالية فقط" Click="ApprovePage"/>
           <MenuItem Header="اعتماد كل المسودات السليمة" Click="ApproveAllDrafts"/>
           <Separator/>
           <MenuItem Header="تصدير النطاق إلى CSV" Click="ExportReview"/>
           <MenuItem Header="استيراد مراجعة CSV" Click="ImportReview"/>
           <MenuItem Header="نسخ المشروع احتياطياً" Click="BackupProject"/>
            <Separator/>
            <MenuItem Header="تصدير حزمة تعريب خفيفة (.locara-patch.json)" Click="ExportPatchClick"/>
            <MenuItem Header="استيراد حزمة تعريب خفيفة" Click="ImportPatchClick"/>
          </MenuItem>
         </Menu>
        </StackPanel>
       </Grid>
      </Border>

      <!-- Split Studio Workspace: Right = Strings Table | Left = Contextual Inspector -->
      <Grid Grid.Row="2">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.55*" MinWidth="420"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="1*" MinWidth="330"/>
       </Grid.ColumnDefinitions>

       <!-- Strings DataGrid -->
       <Border Grid.Column="0" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" ClipToBounds="True">
        <DataGrid x:Name="Rows" BorderThickness="0" RowEditEnding="SaveRowAfterEdit" SelectionChanged="SelectEditorRow" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="62" FontSize="13.5">
         <DataGrid.Columns>
          <DataGridTextColumn Header="النص الأصلي" Binding="{Binding Source}" IsReadOnly="True" Width="*">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="FlowDirection" Value="LeftToRight"/>
             <Setter Property="TextWrapping" Value="Wrap"/>
             <Setter Property="Padding" Value="10,6"/>
             <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="الترجمة العربية" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="1.25*">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="TextWrapping" Value="Wrap"/>
             <Setter Property="FlowDirection" Value="RightToLeft"/>
             <Setter Property="Padding" Value="10,6"/>
             <Setter Property="FontWeight" Value="Medium"/>
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="الحالة" IsReadOnly="True" Width="104">
           <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
             <Border CornerRadius="6" Padding="7,3" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgElevated}">
              <TextBlock FontSize="11.5" FontWeight="SemiBold">
               <TextBlock.Style>
                <Style TargetType="TextBlock">
                 <Setter Property="Text" Value="{Binding Status}"/>
                 <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                 <Style.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="pending"><Setter Property="Text" Value="معلّق"/></DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="translated"><Setter Property="Text" Value="مسودة"/><Setter Property="Foreground" Value="{DynamicResource WarningFg}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="imported"><Setter Property="Text" Value="مستوردة"/><Setter Property="Foreground" Value="{DynamicResource InfoFg}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="approved"><Setter Property="Text" Value="معتمدة ✓"/><Setter Property="Foreground" Value="{DynamicResource SuccessFg}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="conflict"><Setter Property="Text" Value="تعارض !"/><Setter Property="Foreground" Value="{DynamicResource DangerFg}"/></DataTrigger>
                 </Style.Triggers>
                </Style>
               </TextBlock.Style>
              </TextBlock>
             </Border>
            </DataTemplate>
           </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
         </DataGrid.Columns>
        </DataGrid>
       </Border>

       <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

       <!-- Left Contextual Inspector Panel -->
       <Border x:Name="EditorInspectorPanel" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel Margin="0,0,10,0">
          <Grid Margin="0,0,0,6">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="لوحة التحرير والسياق" FontWeight="Bold" FontSize="15.5" Foreground="{DynamicResource TextPrimary}"/>
           <TextBlock Grid.Column="1" x:Name="InspectorLengthText" Text="" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
          </Grid>

          <TextBlock x:Name="InspectorMetaText" Text="اختر سطراً من الجدول لعرض سياقه وتحريره." FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

          <!-- Source Box -->
          <Border Style="{StaticResource SubtleCardBorderStyle}" Padding="11,9" Margin="0,0,0,10">
           <TextBox x:Name="InspectorSourceText" FlowDirection="LeftToRight" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MaxHeight="95" VerticalScrollBarVisibility="Auto" FontSize="13"/>
          </Border>

          <!-- Protected Tokens Bar (Clickable to insert at cursor) -->
          <StackPanel x:Name="InspectorTokensContainer" Visibility="Collapsed" Margin="0,0,0,10">
           <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الرموز المحمية (انقر للإدراج):" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Grid.Column="1" x:Name="InspectorTokenStatusText" FontSize="11.5" FontWeight="SemiBold"/>
           </Grid>
           <ItemsControl x:Name="InspectorTokensList">
            <ItemsControl.ItemsPanel>
             <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Button Tag="{Binding Token}" Click="InsertTokenChipClick" Padding="9,4" Margin="0,0,5,4" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FlowDirection="LeftToRight" ToolTip="انقر لإدراج الرمز في موضع المؤشر">
               <TextBlock Text="{Binding Label}" FontWeight="SemiBold">
                <TextBlock.Style>
                 <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource WarningFg}"/>
                  <Style.Triggers>
                   <DataTrigger Binding="{Binding IsSatisfied}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessFg}"/>
                   </DataTrigger>
                  </Style.Triggers>
                 </Style>
                </TextBlock.Style>
               </TextBlock>
              </Button>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </StackPanel>

          <!-- Live Glossary Consistency Alert -->
          <Border x:Name="InspectorGlossaryAlertBorder" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningFg}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed">
           <TextBlock x:Name="InspectorGlossaryAlertText" Foreground="{DynamicResource WarningFg}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </Border>

          <!-- Warning Banner if Row Has Warning -->
          <TextBlock x:Name="InspectorWarningText" Foreground="{DynamicResource DangerFg}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

          <!-- Comfortable RTL Translation Box -->
          <TextBlock Text="الترجمة العربية (تُحفظ تلقائياً · Ctrl+Enter للاعتماد والتقدم):" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
          <TextBox x:Name="InspectorTargetBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="165" VerticalScrollBarVisibility="Auto" FontSize="14.5" TextChanged="InspectorTargetChanged" KeyDown="InspectorTargetKeyDown" LostFocus="InspectorTargetLostFocus"/>

          <!-- Smart UI Length Overflow Guard -->
          <Border x:Name="InspectorLengthGuardPanel" Background="{DynamicResource BgSubtle}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,8,0,0" Visibility="Collapsed">
           <StackPanel>
            <Grid Margin="0,0,0,5">
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock Grid.Column="0" x:Name="InspectorLengthGuardStatusText" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"/>
             <TextBlock Grid.Column="1" x:Name="InspectorLengthGuardBudgetText" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar x:Name="InspectorLengthBar" Height="5" Minimum="0" Maximum="100" Value="0"/>
           </StackPanel>
          </Border>

          <!-- Live In-Game Arabic Preview -->
           <Border x:Name="InspectorLivePreviewCard" Background="{DynamicResource BgSubtle}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,8,0,0">
            <StackPanel>
             <TextBlock Text="معاينة حيّة داخل اللعبة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
             <WrapPanel Margin="0,0,0,5">
              <TextBlock Text="عرض الصندوق (حرف):" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <RadioButton x:Name="PreviewWidth30" GroupName="PreviewBoxWidth" Style="{StaticResource FilterChipRadioStyle}" Tag="30" Content="30" FlowDirection="LeftToRight" Click="PreviewBoxWidthClick"/>
              <RadioButton x:Name="PreviewWidth45" GroupName="PreviewBoxWidth" Style="{StaticResource FilterChipRadioStyle}" Tag="45" Content="45" FlowDirection="LeftToRight" IsChecked="True" Click="PreviewBoxWidthClick"/>
              <RadioButton x:Name="PreviewWidth60" GroupName="PreviewBoxWidth" Style="{StaticResource FilterChipRadioStyle}" Tag="60" Content="60" FlowDirection="LeftToRight" Click="PreviewBoxWidthClick"/>
             </WrapPanel>
             <WrapPanel Margin="0,0,0,5">
              <RadioButton x:Name="PreviewModeShaped" GroupName="PreviewMode" Style="{StaticResource FilterChipRadioStyle}" Tag="shaped" Content="تشكيل مسبق" IsChecked="True" Click="PreviewModeClick"/>
              <RadioButton x:Name="PreviewModeLogical" GroupName="PreviewMode" Style="{StaticResource FilterChipRadioStyle}" Tag="logical" Content="عربي أصلي" Click="PreviewModeClick"/>
             </WrapPanel>
             <TextBlock x:Name="InspectorLivePreviewSummary" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
             <Border Background="#0A1419" BorderBrush="#24424E" BorderThickness="1.2" CornerRadius="8" Padding="12,9">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
               <TextBlock x:Name="InspectorLivePreviewText" FlowDirection="LeftToRight" TextAlignment="Right" TextWrapping="NoWrap" Foreground="#F1F6F8" FontSize="14.5" MinHeight="22"/>
              </ScrollViewer>
             </Border>
            </StackPanel>
           </Border>

           <WrapPanel Margin="0,10,0,10">
           <Button Content="اعتماد السطر ✓" Click="ApproveAndAdvanceClick" Style="{StaticResource PrimaryButtonStyle}" Padding="13,7" Margin="0,0,6,6"/>
           <Button Content="إعادة ترجمة بالبوت" Click="Retranslate" Padding="10,7" Margin="0,0,6,6"/>
           <Button Content="ذاكرة الترجمة" Click="SuggestMemory" Padding="10,7" Margin="0,0,0,6"/>
          </WrapPanel>

          <!-- Surrounding Scene Context (Dynamic Theme-Reactive) -->
          <TextBlock Text="سياق المشهد المحيط" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,6"/>
          <ItemsControl x:Name="InspectorNeighborsList">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Border BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,0,5">
              <Border.Style>
               <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                <Style.Triggers>
                 <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentIndicator}"/>
                 </DataTrigger>
                </Style.Triggers>
               </Style>
              </Border.Style>
              <StackPanel>
               <TextBlock Text="{Binding Source}" FlowDirection="LeftToRight" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
               <TextBlock Text="{Binding TargetPreview}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                <TextBlock.Style>
                 <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                  <Style.Triggers>
                   <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentIndicator}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                   </DataTrigger>
                  </Style.Triggers>
                 </Style>
                </TextBlock.Style>
               </TextBlock>
              </StackPanel>
             </Border>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Inline Quick Glossary Pin -->
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="0,8,0,0" Padding="11,9">
           <StackPanel>
            <TextBlock Text="تثبيت مصطلح سريع في المعجم" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
             </Grid.ColumnDefinitions>
             <TextBox Grid.Column="0" x:Name="QuickTermSource" FlowDirection="LeftToRight" FontSize="12" Margin="0,0,5,0" ToolTip="المصطلح الأصلي"/>
             <TextBox Grid.Column="1" x:Name="QuickTermTarget" FontSize="12" Margin="2,0,6,0" ToolTip="الترجمة العربية المعتمدة"/>
             <Button Grid.Column="2" Content="تثبيت ★" Click="QuickPinGlossaryClick" FontSize="11.5" Padding="11,6" Margin="0"/>
            </Grid>
           </StackPanel>
          </Border>
         </StackPanel>
        </ScrollViewer>
       </Border>
      </Grid>
     </Grid>
    </TabItem>

    <!-- ==================== STAGE 4: FONT & ONE-CLICK DEPLOYMENT ==================== -->
    <TabItem x:Name="PackagesPage" Header="الخط والتثبيت" IsEnabled="False">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="22,18" MaxWidth="1480" HorizontalAlignment="Stretch">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*" MinWidth="400"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="0.95*" MinWidth="340"/>
       </Grid.ColumnDefinitions>

       <!-- Right Column (Col 0 in RTL): Arabic Display Font & Engine Display Settings -->
       <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
        <StackPanel>
         <TextBlock Text="1. مظهر الخط العربي داخل اللعبة" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
         <TextBlock Text="اختر خطاً عربياً مدمجاً أو أضف خطك الخاص (.ttf / .otf)، وعاين شكله مباشرة قبل التثبيت." FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,12"/>

         <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0" x:Name="DisplayFontSelector" DisplayMemberPath="DisplayName" SelectionChanged="SelectDisplayFont" Margin="0,0,8,0" AutomationProperties.Name="خط العرض العربي"/>
          <Button Grid.Column="1" Content="+ خط خاص" Click="AddCustomFont" ToolTip="إضافة ملف خط خاص (.ttf / .otf)" Margin="0,0,6,0"/>
          <Button Grid.Column="2" x:Name="DeleteCustomFontButton" Content="حذف" Click="DeleteCustomFont" IsEnabled="False" Style="{StaticResource GhostButtonStyle}" Margin="0" ToolTip="حذف الخط الخاص المحدد"/>
         </Grid>

         <TextBlock x:Name="FontCompatibilityStatus" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessFg}" Margin="0,0,0,10"/>

         <!-- Simulated Game HUD Preview -->
         <Border Background="#0A1419" BorderBrush="#24424E" BorderThickness="1.2" CornerRadius="10" Padding="18,14">
          <StackPanel>
           <TextBlock Text="معاينة شاشة اللعبة" FontSize="10.5" Foreground="#7EA5B3" Margin="0,0,0,5"/>
           <TextBlock x:Name="FontPreviewTitle" Text="مهمة جديدة: استكشاف القلعة القديمة · استمرار · الإعدادات" Foreground="#F6C84C" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,6"/>
           <TextBlock x:Name="FontPreviewBody" Text="«هل أنت مستعد لبدء الرحلة؟ تأكد من تجهيز معداتك قبل عبور البوابة الشمالية (100%).»" Foreground="#F1F6F8" FontSize="14.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
           <TextBlock x:Name="FontPreviewMenu" Text="[E] تفاعل   ·   [Tab] الخريطة والمهام   ·   حفظ التقدّم   ·   القائمة الرئيسية" Foreground="#A7CBD7" FontSize="12.5" TextWrapping="Wrap"/>
          </StackPanel>
         </Border>

         <!-- Engine-Conditional: Unity TextMeshPro Settings (ONLY visible on Unity projects) -->
         <Border x:Name="UnityTmpSettingsBorder" Visibility="Collapsed" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,12,0,0">
          <StackPanel>
           <TextBlock Text="ضبط العرض العربي لمحرك Unity (TextMeshPro)" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" FontSize="13" Margin="0,0,0,8"/>
           <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="1.45*"/>
             <ColumnDefinition Width="12"/>
             <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
             <TextBlock Text="التفاف الأسطر" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
             <ComboBox x:Name="UnityWrapModeSelector" SelectionChanged="SelectUnityArabicSettings" AutomationProperties.Name="التفاف الأسطر العربية في Unity">
              <ComboBoxItem Tag="auto" Content="تلقائي ذكي للبطاقات والحوارات (موصى به)"/>
              <ComboBoxItem Tag="16" Content="ضيق جداً للبطاقات الصغيرة (16 حرفاً)"/>
              <ComboBoxItem Tag="20" Content="ضيق للبطاقات (20 حرفاً)"/>
              <ComboBoxItem Tag="30" Content="متوسط (30 حرفاً)"/>
              <ComboBoxItem Tag="45" Content="واسع للحوارات (45 حرفاً)"/>
              <ComboBoxItem Tag="0" Content="إيقاف الالتفاف التلقائي"/>
             </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
             <TextBlock Text="مقياس حجم الخط" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
             <ComboBox x:Name="UnityFontScaleSelector" SelectionChanged="SelectUnityArabicSettings" AutomationProperties.Name="حجم الخط العربي في Unity">
              <ComboBoxItem Tag="0.70" Content="70% (صغير)"/>
              <ComboBoxItem Tag="0.75" Content="75%"/>
              <ComboBoxItem Tag="0.80" Content="80% (افتراضي)"/>
              <ComboBoxItem Tag="0.85" Content="85%"/>
              <ComboBoxItem Tag="0.90" Content="90%"/>
              <ComboBoxItem Tag="0.95" Content="95%"/>
              <ComboBoxItem Tag="1.00" Content="100% (كامل)"/>
              <ComboBoxItem Tag="1.10" Content="110% (كبير)"/>
             </ComboBox>
            </StackPanel>
           </Grid>
           <CheckBox x:Name="UnityArabicShapingToggle" IsChecked="True" Checked="SelectUnityArabicSettings" Unchecked="SelectUnityArabicSettings" FontSize="12" Margin="0,4,0,4">
            <TextBlock Text="تشكيل وترتيب العربية مسبقاً لـ TextMeshPro (أوقِفه فقط إذا كانت اللعبة تدعم RTL أصلياً)" TextWrapping="Wrap"/>
           </CheckBox>
           <CheckBox x:Name="UnityContrastBoostToggle" IsChecked="False" Checked="SelectUnityArabicSettings" Unchecked="SelectUnityArabicSettings" FontSize="12" Margin="0,4,0,2">
            <TextBlock Text="تعزيز وضوح الحروف العربية على الأزرار الفاتحة (خط أعرض + تحسين حواف SDF)" TextWrapping="Wrap"/>
           </CheckBox>
          </StackPanel>
         </Border>

         <!-- Engine-Conditional: Classic Unity (UI.Text / NGUI) Runtime Line-Wrap Reflow Plugin -->
         <Border x:Name="UnityClassicRtlPluginBorder" Visibility="Collapsed" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,12,0,0">
          <StackPanel>
           <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="إصلاح التفاف الصناديق الضيقة (UI.Text / NGUI)" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" x:Name="UnityRtlPluginStatusBadge" Text="" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
           </Grid>
           <TextBlock x:Name="UnityRtlPluginDetailText" Text="" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
           <CheckBox x:Name="IncludeClassicRtlPluginToggle" IsChecked="False" Checked="SelectClassicRtlPluginOption" Unchecked="SelectClassicRtlPluginOption" FontSize="12" Margin="0,0,0,8">
            <TextBlock Text="تضمين ملحق إصلاح الالتفاف تلقائياً مع حزمة التثبيت والتصدير" TextWrapping="Wrap"/>
           </CheckBox>
           <WrapPanel>
            <Button x:Name="InstallUnityRtlPluginBtn" Content="تثبيت ملحق الالتفاف الآن (مع نسخة احتياطية)" Click="InstallUnityRtlPluginClick" FontSize="12" Padding="11,6" Margin="0,0,6,4"/>
            <Button x:Name="RemoveUnityRtlPluginBtn" Content="إزالة الملحق واستعادة الأصل" Click="RemoveUnityRtlPluginClick" Style="{StaticResource GhostButtonStyle}" FontSize="12" Padding="11,6" Visibility="Collapsed" Margin="0,0,0,4"/>
           </WrapPanel>
          </StackPanel>
         </Border>

         <!-- Engine-Conditional: GameMaker data.win Arabic Pre-Shaping (ONLY visible on GameMaker projects) -->
          <Border x:Name="GameMakerSettingsBorder" Visibility="Collapsed" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,12,0,0">
           <StackPanel>
            <TextBlock Text="ضبط العرض العربي لمحرك GameMaker (data.win)" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" FontSize="13" Margin="0,0,0,6"/>
            <CheckBox x:Name="GameMakerShapeArabicToggle" IsChecked="False" Checked="SelectGameMakerShapeArabic" Unchecked="SelectGameMakerShapeArabic" FontSize="12">
             <TextBlock Text="تشكيل الحروف العربية مسبقاً عند البناء في data.win (معطّل افتراضياً — اتركه معطّلاً للعرض بـ UTF-8 المنطقي)" TextWrapping="Wrap"/>
            </CheckBox>
           </StackPanel>
          </Border>

          <!-- Engine-Conditional: Gettext (.pot -> .po) Target -->
         <Border x:Name="GettextPoTargetBorder" Visibility="Collapsed" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,12,0,0">
          <StackPanel>
           <TextBlock Text="هدف تصدير ملفات Gettext (.pot → .po)" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" FontSize="13" Margin="0,0,0,6"/>
           <ComboBox x:Name="GettextPoTargetSelector" SelectionChanged="SelectGettextPoTarget" FontSize="12" AutomationProperties.Name="هدف تصدير ملف Gettext PO"/>
           <TextBlock x:Name="GettextPoTargetHint" Text="اختر استبدال إحدى اللغات المثبّتة داخل اللعبة ثم فعّلها من إعدادات اللعبة، مع حفظ نسخة احتياطية كاملة." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
         </Border>
        </StackPanel>
       </Border>

       <!-- Left Column (Col 2 in RTL): Smart One-Click Deployment + Standalone Export + Build Log -->
       <StackPanel Grid.Column="2" VerticalAlignment="Top">
        <!-- Pre-Build QA Gate -->
         <Border x:Name="QaGateCard" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
          <StackPanel>
           <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="بوابة فحص الجاهزية قبل البناء والتثبيت" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Border Grid.Column="1" x:Name="QaGateBadge" Background="{DynamicResource BgSubtle}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="9,2.5" VerticalAlignment="Center" Margin="8,0,0,0">
             <TextBlock x:Name="QaGateBadgeText" Text="…" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
            </Border>
           </Grid>
           <TextBlock x:Name="QaGateSummaryText" Text="يفحص الأخطاء الحرجة وتحذيرات الجودة قبل البناء والتثبيت داخل اللعبة." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Grid Margin="0,0,0,6">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="أخطاء الرموز والتعارضات" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
           <TextBlock Grid.Column="1" x:Name="QaCountIssues" Text="—" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight" MinWidth="36" TextAlignment="Center" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextMuted}"/>
           <Button Grid.Column="2" x:Name="QaFixIssuesButton" Tag="issues" Content="إصلاح في المحرّر ←" Click="QaGateFixClick" FontSize="11.5" Padding="9,4" Margin="0" IsEnabled="False"/>
          </Grid>
          <Grid Margin="0,0,0,6">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="مخالفات المعجم" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
           <TextBlock Grid.Column="1" x:Name="QaCountGlossary" Text="—" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight" MinWidth="36" TextAlignment="Center" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextMuted}"/>
           <Button Grid.Column="2" x:Name="QaFixGlossaryButton" Tag="glossary" Content="إصلاح في المحرّر ←" Click="QaGateFixClick" FontSize="11.5" Padding="9,4" Margin="0" IsEnabled="False"/>
          </Grid>
          <Grid Margin="0,0,0,6">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="غير مترجمة / فارغة" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
           <TextBlock Grid.Column="1" x:Name="QaCountPending" Text="—" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight" MinWidth="36" TextAlignment="Center" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextMuted}"/>
           <Button Grid.Column="2" x:Name="QaFixPendingButton" Tag="pending" Content="إصلاح في المحرّر ←" Click="QaGateFixClick" FontSize="11.5" Padding="9,4" Margin="0" IsEnabled="False"/>
          </Grid>
          <Grid Margin="0,0,0,6">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="تحذيرات طول الواجهة" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
           <TextBlock Grid.Column="1" x:Name="QaCountLength" Text="—" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight" MinWidth="36" TextAlignment="Center" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextMuted}"/>
           <Button Grid.Column="2" x:Name="QaFixLengthButton" Tag="length" Content="إصلاح في المحرّر ←" Click="QaGateFixClick" FontSize="11.5" Padding="9,4" Margin="0" IsEnabled="False"/>
          </Grid>
          <Button x:Name="QaGateRescanButton" Content="إعادة فحص" Click="QaGateRescanClick" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
          </StackPanel>
         </Border>

         <!-- Card 2: Smart One-Click In-Place Deployment & Playtest -->
        <Border Style="{StaticResource CardBorderStyle}">
         <StackPanel>
          <TextBlock Text="2. التثبيت الذكي داخل اللعبة والتجربة" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="يثبّت التعريب والخط العربي مباشرة في مسار اللعبة مع نسخة احتياطية مؤكدة ببصمة SHA-256 للاستعادة بضغطة واحدة." FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,12"/>

          <Border x:Name="DirectInstallStatusBorder" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,0,0,12">
           <StackPanel>
            <TextBlock x:Name="DirectInstallStatusTitle" Text="الحالة: جارٍ فحص حالة التثبيت…" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,3"/>
            <TextBlock x:Name="DirectInstallStatusDetail" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
           </StackPanel>
          </Border>

          <WrapPanel>
           <Button x:Name="DirectInstallButton" Content="ثبّت التعريب داخل اللعبة (مع نسخة احتياطية)" Click="DirectInstallGame" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,6"/>
           <Button x:Name="DirectRestoreButton" Content="إزالة التعريب واستعادة الأصل" Click="DirectRestoreGame" Visibility="Collapsed" Margin="0,0,6,6"/>
           <Button x:Name="AcceptGameUpdateButton" Content="اعتماد تحديث اللعبة الجديد" Click="AcceptExternalGameUpdate" Visibility="Collapsed" Margin="0,0,6,6"/>
           <Button x:Name="PackageTrial" Content="تجربة مؤقتة وتستعاد تلقائياً" Click="TryGame" Visibility="Collapsed" Margin="0,0,0,6"/>
          </WrapPanel>
         </StackPanel>
        </Border>

        <!-- Card 3: Standalone Mod Package Export & Advanced Tools -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
         <StackPanel>
          <TextBlock Text="3. تصدير حزمة مستقلة للمشاركة" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="لإنتاج مجلد تعريب منفصل جاهز للنشر أو المشاركة دون تعديل ملفات اللعبة المثبّتة." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,12"/>
          <UniformGrid Columns="2" Margin="0,0,0,4">
           <Button Content="بناء حزمة نهائية للمشاركة" Click="BuildFinal" Margin="0,0,5,6"/>
           <Button Content="بناء حزمة معاينة (مسودات)" Click="BuildPreview" Margin="5,0,0,6"/>
           <Button Content="تصدير XUnity (BepInEx)" Click="ExportXUnity" Margin="0,0,5,0" ToolTip="لألعاب Unity ذات النصوص المدمجة في الكود البرمجي"/>
           <Button Content="فتح مجلد آخر ناتج" Click="OpenOutput" Margin="5,0,0,0"/>
            <Button Content="تصدير حزمة تعريب خفيفة (.locara-patch.json)" Click="ExportPatchClick" Margin="0,6,5,0" ToolTip="ملف JSON صغير يحوي الترجمات المعتمدة فقط للمشاركة"/>
            <Button Content="استيراد حزمة تعريب خفيفة" Click="ImportPatchClick" Margin="5,6,0,0" ToolTip="دمج حزمة تعريب خفيفة مع معاينة وفحص رموز قبل التطبيق"/>
          </UniformGrid>

          <Expander Header="أدوات التثبيت والاستعادة اليدوية المتقدمة" Margin="0,10,0,0">
           <WrapPanel>
            <Button Content="تثبيت حزمة على نسخة لعبة أخرى" Click="Install" Margin="0,0,6,4"/>
            <Button Content="استعادة ملفات من إيصال سابق" Click="Restore" Margin="0,0,6,4"/>
            <Button x:Name="SteamRecoveryButton" Content="استعادة تجربة Steam معلّقة" Click="RetryTrialRecovery" Visibility="Collapsed" Margin="0,0,0,4"/>
           </WrapPanel>
          </Expander>
         </StackPanel>
        </Border>

        <Expander Header="سجل البناء والتثبيت التفصيلي" IsExpanded="False" Margin="0,12,0,0">
         <TextBox x:Name="BuildLog" Height="130" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
        </Expander>
       </StackPanel>
      </Grid>
     </ScrollViewer>
    </TabItem>

    <!-- ==================== DEDICATED VIEW: SETTINGS, API & ROUTING ==================== -->
    <TabItem x:Name="SettingsPage" Header="الإعدادات والـ API">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,18" MaxWidth="1480" HorizontalAlignment="Stretch">

       <TextBlock Text="الإعدادات واتصالات الذكاء الاصطناعي" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="أدِر ملفات اتصال الـ API، وتوجيه النماذج للبوتات، وأسعار التوكنز في مكان واحد مستقل عن شاشة العمل اليومية." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,14"/>

       <!-- Segmented Settings Switcher (Left in RTL = Physical Right!) -->
       <Border Background="{DynamicResource BgSubtle}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="9" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,14">
        <WrapPanel>
         <RadioButton x:Name="SettingsTabApi" GroupName="SettingsSubTabs" Style="{StaticResource SegmentedRadioStyle}" IsChecked="True" Checked="SettingsSubTabChanged" Content="اتصالات الـ API والنماذج"/>
         <RadioButton x:Name="SettingsTabRouting" GroupName="SettingsSubTabs" Style="{StaticResource SegmentedRadioStyle}" Checked="SettingsSubTabChanged" Content="توجيه البوتات والأسلوب والميزانية"/>
         <RadioButton x:Name="SettingsTabUsage" GroupName="SettingsSubTabs" Style="{StaticResource SegmentedRadioStyle}" Checked="SettingsSubTabChanged" Content="سجل الاستهلاك وأسعار النماذج ($)"/>
        </WrapPanel>
       </Border>

       <!-- SETTINGS SUB-VIEW 1: API Connections -->
       <Border x:Name="ConnectionPanel" Style="{StaticResource CardBorderStyle}">
        <StackPanel>
         <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="0,0,0,16">
          <StackPanel>
           <TextBlock Text="ملفات الاتصال المحفوظة (يمكنك حفظ أكثر من مزوّد وتوزيعها على البوتات)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" Margin="0,0,0,8"/>
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="1.15*"/>
             <ColumnDefinition Width="10"/>
             <ColumnDefinition Width="*"/>
             <ColumnDefinition Width="10"/>
             <ColumnDefinition Width="Auto"/>
             <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="ProfileSelector" DisplayMemberPath="Name" SelectionChanged="SelectProviderProfile" AutomationProperties.Name="ملف الاتصال المحفوظ"/>
            <TextBox Grid.Column="2" x:Name="ProfileNameInput" ToolTip="اسم ملف الاتصال (مثال: DeepSeek أو Gemini)" AutomationProperties.Name="اسم ملف الاتصال"/>
            <Button Grid.Column="4" Content="+ اتصال جديد" Click="AddProviderProfile" Margin="0,0,6,0"/>
            <Button Grid.Column="5" x:Name="DeleteProfileButton" Content="حذف الاتصال" Click="DeleteProviderProfile" Style="{StaticResource GhostButtonStyle}" Margin="0"/>
           </Grid>
          </StackPanel>
         </Border>

         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="16"/>
           <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
           <TextBlock Text="المزوّد (Provider)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
           <ComboBox x:Name="Provider" SelectedIndex="0" Margin="0,0,0,10">
            <ComboBoxItem Content="openai-compatible"/>
            <ComboBoxItem Content="gemini"/>
            <ComboBoxItem Content="anthropic"/>
            <ComboBoxItem Content="deepseek"/>
            <ComboBoxItem Content="azure"/>
           </ComboBox>

           <TextBlock Text="عنوان API المخصّص أو المحلي (Base URL)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
           <TextBox x:Name="ApiUrl" FlowDirection="LeftToRight" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,10"/>

           <StackPanel x:Name="AzureRegionPanel" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock Text="منطقة Azure (Region)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
            <TextBox x:Name="Region" FlowDirection="LeftToRight"/>
           </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2">
           <TextBlock Text="مفتاح الـ API (يُحفظ مشفّراً في خزنة Windows)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
           <PasswordBox x:Name="ApiKey" Margin="0,0,0,10"/>

           <StackPanel x:Name="ModelPicker" Margin="0,0,0,10">
            <TextBlock Text="النموذج الافتراضي لهذا الاتصال" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <ComboBox Grid.Column="0" x:Name="Model" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="260" FlowDirection="LeftToRight" Margin="0,2,8,2" AutomationProperties.Name="النموذج"/>
             <Button Grid.Column="1" x:Name="FetchModelsButton" Content="جلب النماذج" Click="FetchModels" Margin="0"/>
            </Grid>
            <TextBlock x:Name="ModelListStatus" Visibility="Collapsed" FontSize="11.5" Foreground="{DynamicResource AccentIndicator}" Margin="0,4,0,0" TextWrapping="Wrap"/>
           </StackPanel>
          </StackPanel>
         </Grid>

         <CheckBox x:Name="JsonMode" Content="فرض صيغة JSON المهيكلة (response_format)" Margin="0,2,0,6"/>

         <Expander x:Name="CertificateOptions" Header="شهادة HTTPS الخاصة للخوادم الذاتية التوقيع" Margin="0,0,0,10">
          <StackPanel>
           <TextBlock Text="بصمة SHA-256 لشهادة الخادم:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
           <TextBox x:Name="CertificateSha256" FlowDirection="LeftToRight" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="بصمة SHA-256 لشهادة الخادم"/>
          </StackPanel>
         </Expander>

         <WrapPanel Margin="0,6,0,0">
          <Button Content="حفظ ملف الاتصال" Click="SaveProvider" Style="{StaticResource PrimaryButtonStyle}"/>
          <CheckBox x:Name="KeepApiKey" Content="تذكّر المفتاح في خزنة Windows" VerticalAlignment="Center" Margin="8,0"/>
          <Button Content="إزالة المفتاح المحفوظ" Click="ForgetProviderKey" Style="{StaticResource GhostButtonStyle}"/>
         </WrapPanel>
        </StackPanel>
       </Border>

       <!-- SETTINGS SUB-VIEW 2: Bot Routing, Prompts & Budget -->
       <StackPanel x:Name="RoutingPanel" Visibility="Collapsed">
        <Border x:Name="RoutingNoProjectNotice" Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource InfoFg}" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
         <TextBlock Text="افتح مشروع لعبة أولاً لتخصيص توجيه النماذج وأسلوب الترجمة الخاص بالمشروع (حدود الميزانية العامة أدناه متاحة دائماً)." Foreground="{DynamicResource InfoFg}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <Border x:Name="ProjectRoutingAndStyleCard" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
         <StackPanel>
          <TextBlock Text="توزيع النماذج والـ API على البوتات" FontSize="16.5" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock Text="يمكنك تشغيل بوت الكشّاف أو المدقق بنموذج عميق وبوتات المشاهد بنموذج سريع، أو تخصيص كل بوت على حدة." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

          <Grid Margin="0,0,0,10">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="165"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
           </Grid.ColumnDefinitions>
           <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
           </Grid.RowDefinitions>
           <TextBlock Grid.Row="0" Grid.Column="0" Text="البوت / الدور" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
           <TextBlock Grid.Row="0" Grid.Column="1" Text="ملف الاتصال (API)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
           <TextBlock Grid.Row="0" Grid.Column="2" Text="النموذج المخصّص (اتركه فارغاً لافتراضي الاتصال)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>

           <TextBlock Grid.Row="1" Grid.Column="0" Text="بوتات المشاهد (المترجم)" VerticalAlignment="Center" FontWeight="Medium"/>
           <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TranslatorProfileInput" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="RoleProfileChanged" Margin="0,3,8,3"/>
           <ComboBox Grid.Row="1" Grid.Column="2" x:Name="TranslatorModelInput" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="240" FlowDirection="LeftToRight" LostFocus="RoutingFieldChanged" SelectionChanged="RoutingFieldChanged" Margin="0,3"/>

           <TextBlock Grid.Row="2" Grid.Column="0" Text="بوت المدقق الذكي" VerticalAlignment="Center" FontWeight="Medium"/>
           <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ReviewerProfileInput" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="RoleProfileChanged" Margin="0,3,8,3"/>
           <ComboBox Grid.Row="2" Grid.Column="2" x:Name="ReviewerModelInput" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="240" FlowDirection="LeftToRight" LostFocus="RoutingFieldChanged" SelectionChanged="RoutingFieldChanged" Margin="0,3"/>

           <TextBlock Grid.Row="3" Grid.Column="0" Text="بوت الكشّاف والعالم" VerticalAlignment="Center" FontWeight="Medium"/>
           <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SupervisorProfileInput" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="RoleProfileChanged" Margin="0,3,8,3"/>
           <ComboBox Grid.Row="3" Grid.Column="2" x:Name="SupervisorModelInput" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="240" FlowDirection="LeftToRight" LostFocus="RoutingFieldChanged" SelectionChanged="RoutingFieldChanged" Margin="0,3"/>
          </Grid>

          <CheckBox x:Name="EnablePerWorkerRouting" Content="تخصيص فردي لكل بوت متوازٍ (وكيل #1، #2، …)" FontWeight="SemiBold" Checked="TogglePerWorkerRouting" Unchecked="TogglePerWorkerRouting" Margin="0,4,0,6"/>
          <Border x:Name="PerWorkerRoutingContainer" Visibility="Collapsed" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,0,0,12">
           <ItemsControl x:Name="WorkerRoutingList">
            <ItemsControl.ItemTemplate>
             <DataTemplate>
              <Grid Margin="0,2">
               <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
               </Grid.ColumnDefinitions>
               <TextBlock Grid.Column="0" Text="{Binding AgentName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
               <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedProfile, Mode=TwoWay}" Margin="0,2,8,2"/>
               <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableModels}" Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="220" FlowDirection="LeftToRight" Margin="0,2"/>
              </Grid>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </Border>

          <!-- Style Presets & Role Instructions -->
          <Border x:Name="RolesPanel" Style="{StaticResource SubtleCardBorderStyle}" Margin="0,4,0,12">
           <StackPanel>
            <TextBlock Text="أسلوب الصياغة العربية وتوجيهات الأدوار" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,8">
             <TextBlock Text="قالب جاهز:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
             <ComboBox x:Name="PromptPresetSelector" Width="340" DisplayMemberPath="Name" Margin="0,0,8,0" AutomationProperties.Name="قالب التوجيهات الجاهز"/>
             <Button Content="تطبيق القالب" Click="ApplySelectedPromptPreset"/>
            </WrapPanel>
            <TextBlock Text="أسلوب المشروع العام:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
            <TextBox x:Name="TeamStyleInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" Margin="0,0,0,8"/>

            <Expander Header="تعليمات مخصّصة إضافية للكشّاف / المترجم / المدقق (للمتقدمين)">
             <UniformGrid Columns="3">
              <TextBox x:Name="SupervisorPromptInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" Margin="0,0,4,0" ToolTip="تعليمات بوت الكشّاف"/>
              <TextBox x:Name="TranslatorPromptInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" Margin="2,0" ToolTip="تعليمات بوت المترجم"/>
              <TextBox x:Name="ReviewerPromptInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" Margin="4,0,0,0" ToolTip="تعليمات بوت المدقق"/>
             </UniformGrid>
            </Expander>
           </StackPanel>
          </Border>

          <WrapPanel>
           <Button Content="حفظ إعدادات التوجيه والأسلوب للمشروع" Click="SaveTeamRoleSettings" Style="{StaticResource PrimaryButtonStyle}"/>
           <Button Content="معاينة التعليمات الكاملة" Click="PreviewTeamPrompts"/>
           <Button Content="إعادة التوجيه للافتراضي" Click="ResetRoutingSettings" Style="{StaticResource GhostButtonStyle}"/>
           <Button Content="استعادة قوالب الأدوار" Click="ResetTeamRoleSettings" Style="{StaticResource GhostButtonStyle}"/>
          </WrapPanel>
         </StackPanel>
        </Border>

        <!-- Global / Resume Budget Caps -->
        <Border x:Name="BudgetPanel" Style="{StaticResource CardBorderStyle}">
         <StackPanel>
          <TextBlock Text="سقف الميزانية والطلبات" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
          <CheckBox x:Name="UnlimitedBudget" IsChecked="True" Checked="UnlimitedBudgetChanged" Unchecked="UnlimitedBudgetChanged" Content="بلا سقف (أكمل تعريب النطاق بالكامل دون توقف تلقائي)"/>
          <WrapPanel Margin="0,6,0,0">
           <TextBlock Text="حد الأحرف:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
           <TextBox x:Name="CharacterBudget" Text="500000" Width="120" FlowDirection="LeftToRight" Margin="0,0,14,0"/>
           <TextBlock Text="حد الطلبات:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
           <TextBox x:Name="RequestBudget" Text="500" Width="95" FlowDirection="LeftToRight" Margin="0,0,10,0"/>
           <Button Content="حفظ حدود الميزانية" Click="SaveBudgetSettingsClick"/>
           <Button x:Name="EstimateResumeBtn" Content="حساب حدود الاستئناف" Click="EstimateTeamBudget"/>
           <Button x:Name="EstimateScopeBtn" Content="تقدير حجم النطاق" Click="Estimate"/>
           <Button x:Name="ResumeSingleBatchBtn" Content="استئناف دفعة فردية سابقة" Click="ResumeTranslation" Style="{StaticResource GhostButtonStyle}"/>
          </WrapPanel>
         </StackPanel>
        </Border>

        <!-- Cross-Project Shared Translation Memory -->
        <Border x:Name="SharedMemorySettingsCard" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
         <StackPanel>
          <TextBlock Text="الذاكرة المشتركة عابرة للمشاريع (Shared Translation Memory)" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock Text="تحفظ تلقائياً ترجماتك المعتمدة (مثل أزرار القوائم والإعدادات الشائعة) محلياً لتعبئة النصوص المتطابقة 100% في مشاريعك القادمة قبل تشغيل البوتات." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <TextBlock x:Name="SharedMemorySettingsStats" Text="جارٍ قراءة إحصاءات الذاكرة المشتركة…" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}" Margin="0,0,0,10"/>
          <WrapPanel>
           <Button x:Name="SyncSharedMemoryBtn" Content="مزامنة نصوص المشروع المعتمدة الآن" Click="SyncSharedMemoryClick"/>
           <Button Content="مسح الذاكرة المشتركة" Click="ClearSharedMemoryClick" Style="{StaticResource GhostButtonStyle}"/>
          </WrapPanel>
         </StackPanel>
        </Border>
       </StackPanel>

       <!-- SETTINGS SUB-VIEW 3: Lifetime Usage & Model Pricing -->
       <Border x:Name="UsageCostPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="سجل استهلاك المشروع وأسعار النماذج ($)" FontSize="16.5" FontWeight="Bold" Margin="0,0,0,10"/>

         <UniformGrid Columns="3" Margin="0,0,0,12">
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="0,0,5,0">
           <StackPanel>
            <TextBlock Text="إجمالي توكنز المشروع" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="UsageSummaryTokens" Text="0" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
            <TextBlock x:Name="UsageSummaryBreakdown" Text="دخل: 0 · خرج: 0" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
           </StackPanel>
          </Border>
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="3,0">
           <StackPanel>
            <TextBlock Text="إجمالي التكلفة التقديرية" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="UsageSummaryCost" Text="$0.00" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessFg}" Margin="0,2,0,0"/>
            <TextBlock x:Name="UsageSummaryCostHint" Text="تقديري حسب أسعار النماذج" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
           </StackPanel>
          </Border>
          <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="5,0,0,0">
           <StackPanel>
            <TextBlock Text="الطلبات التراكمية" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="UsageSummaryRequests" Text="0 طلب" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentIndicator}" Margin="0,2,0,0"/>
            <TextBlock Text="محفوظة عبر كل جلسات المشروع" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
           </StackPanel>
          </Border>
         </UniformGrid>

         <DataGrid x:Name="UsageLedgerGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="36" MaxHeight="220" FontSize="12" SelectionChanged="SelectUsageRow">
          <DataGrid.Columns>
           <DataGridTextColumn Header="النموذج" Binding="{Binding Model}" Width="1.6*">
            <DataGridTextColumn.ElementStyle>
             <Style TargetType="TextBlock">
              <Setter Property="FlowDirection" Value="LeftToRight"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Padding" Value="8,0"/>
             </Style>
            </DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
           <DataGridTextColumn Header="الطلبات" Binding="{Binding RequestsText}" Width="68">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
           <DataGridTextColumn Header="دخل (In)" Binding="{Binding InputText}" Width="92">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
           <DataGridTextColumn Header="خرج (Out)" Binding="{Binding OutputText}" Width="92">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
           <DataGridTextColumn Header="تفكير" Binding="{Binding ThinkingText}" Width="88">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
           <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalText}" Width="96">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
           <DataGridTextColumn Header="1M دخل" Binding="{Binding InputPriceText}" Width="84">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
           <DataGridTextColumn Header="1M خرج" Binding="{Binding OutputPriceText}" Width="84">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
           <DataGridTextColumn Header="التكلفة ($)" Binding="{Binding CostText}" Width="90">
            <DataGridTextColumn.ElementStyle>
             <Style TargetType="TextBlock">
              <Setter Property="FlowDirection" Value="LeftToRight"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Foreground" Value="{DynamicResource SuccessFg}"/>
             </Style>
            </DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
          </DataGrid.Columns>
         </DataGrid>

         <Border Style="{StaticResource SubtleCardBorderStyle}" Margin="0,12,0,0">
          <StackPanel>
           <TextBlock Text="تخصيص سعر النموذج (بالدولار لكل 1 مليون توكن — متاح دائماً):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="1.5*"/>
             <ColumnDefinition Width="10"/>
             <ColumnDefinition Width="0.7*"/>
             <ColumnDefinition Width="10"/>
             <ColumnDefinition Width="0.7*"/>
             <ColumnDefinition Width="12"/>
             <ColumnDefinition Width="Auto"/>
             <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
             <TextBlock Text="النموذج" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
             <TextBox x:Name="PriceModelInput" FlowDirection="LeftToRight" FontFamily="{StaticResource MonoFont}" ToolTip="اختر صفاً من الجدول أو اكتب اسم النموذج"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
             <TextBlock Text="1M دخل ($)" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
             <TextBox x:Name="PriceInputPerMillion" FlowDirection="LeftToRight" ToolTip="مثال: 0.30"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
             <TextBlock Text="1M خرج ($)" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
             <TextBox x:Name="PriceOutputPerMillion" FlowDirection="LeftToRight" ToolTip="مثال: 2.50"/>
            </StackPanel>
            <Button Grid.Column="6" Content="حفظ السعر" Click="SaveModelPrice" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,6,2"/>
            <Button Grid.Column="7" Content="استعادة الافتراضي" Click="ResetModelPrice" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
           </Grid>
          </StackPanel>
         </Border>
        </StackPanel>
       </Border>

       <!-- Quiet GitHub Releases Update Settings -->
       <Border x:Name="AppUpdatesSettingsCard" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
        <StackPanel>
         <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="تحديثات Locara والإصدار" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="9,2.5" VerticalAlignment="Center">
           <TextBlock x:Name="AppCurrentVersionText" Text="v1.5.0" FlowDirection="LeftToRight" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentIndicator}"/>
          </Border>
         </Grid>
         <TextBlock Text="يتحقّق Locara بهدوء عند التشغيل من أحدث إصدار رسمي عبر GitHub Releases (y1nn/Locara) بمهلة قصيرة وبدون أي تتبّع أو خوادم خارجية." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
         <CheckBox x:Name="AutoCheckUpdatesCheckBox" IsChecked="True" Checked="AutoCheckUpdatesChanged" Unchecked="AutoCheckUpdatesChanged" Content="التحقق التلقائي الهادئ من التحديثات عند تشغيل البرنامج" Margin="0,0,0,8"/>
         <TextBlock x:Name="UpdateCheckStatusText" Text="التحقق التلقائي مفعّل." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <StackPanel x:Name="SelfUpdateProgressPanel" Visibility="Collapsed" Margin="0,0,0,10">
           <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="SelfUpdateProgressText" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="SelfUpdateCancelButton" Content="إلغاء التنزيل" Click="CancelSelfUpdateClick" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"/>
           </Grid>
           <ProgressBar x:Name="SelfUpdateProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"/>
          </StackPanel>
         <WrapPanel>
          <Button x:Name="CheckUpdatesNowButton" Content="التحقق من التحديثات الآن" Click="CheckUpdatesNowClick"/>
          <Button x:Name="OpenUpdateReleaseButton" Content="فتح صفحة الإصدار على GitHub ↗" Click="OpenAvailableUpdateClick" Style="{StaticResource OutlineAccentButtonStyle}" Visibility="Collapsed"/>
           <Button x:Name="SelfUpdateInstallButton" Content="تنزيل وتثبيت التحديث تلقائياً (موثّق بـ SHA-256)" Click="SelfUpdateInstallClick" Style="{StaticResource OutlineAccentButtonStyle}" Visibility="Collapsed"/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>

   <!-- Sleek Bottom Studio Status Strip -->
   <Border Grid.Row="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,7">
    <StackPanel>
     <ProgressBar x:Name="Busy" Height="2.5" Visibility="Collapsed" IsIndeterminate="True" Margin="0,0,0,5"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" x:Name="Status" Text="جاهز" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <TextBlock x:Name="TrialRecoveryStatus" FontSize="12" Foreground="{DynamicResource WarningFg}" Margin="0,0,12,0"/>
       <TextBlock x:Name="TeamStatus" FontSize="12" Foreground="{DynamicResource AccentIndicator}"/>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
