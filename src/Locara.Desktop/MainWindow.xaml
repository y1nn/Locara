<Window x:Class="Locara.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Locara" Width="1280" Height="840" MinWidth="780" MinHeight="520" Background="#F5F6F2" Foreground="#152D32" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FlowDirection="RightToLeft">
 <Grid Margin="14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Header -->
  <Border Background="#143C42" CornerRadius="10" Padding="16,9" Margin="0,0,0,10">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right">
     <TextBlock Text="Locara" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0"/>
     <TextBlock x:Name="ProjectTitle" Text="مشاريعي" Foreground="#B7DFCE" FontSize="13" Margin="0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
     <Button x:Name="HeaderNewButton" Content="مشروع جديد" Click="CreateProject"/>
     <Button x:Name="HeaderOpenButton" Content="فتح مشروع" Click="OpenProject"/>
     <Button x:Name="HeaderCancelButton" Content="إيقاف العملية" Click="CancelWork" Background="#C0392B" Foreground="White" FontWeight="SemiBold" Visibility="{Binding Visibility, ElementName=Busy}"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- Main Tabs -->
  <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="NavigateWorkspace" Background="#EDF1EE" BorderThickness="0" Foreground="#172334">

   <!-- Tab 1: My Projects -->
   <TabItem Header="مشاريعي">
    <StackPanel Margin="28" Background="Transparent" AllowDrop="True" PreviewDragOver="SourceDragOver" Drop="DropSource">
     <TextBlock Text="ابدأ مشروع تعريب" FontSize="24" FontWeight="SemiBold"/>
     <TextBlock Text="اختر لعبتك من مكتبة Steam أو حدّد مجلد اللعبة أو اسحب ملف اللغة وأسقطه هنا." Foreground="#476064" Margin="4,4,4,12"/>
     <WrapPanel>
      <Button Content="مكتبة Steam" Click="StartSteamSource" Background="#17645E" Foreground="White" FontWeight="SemiBold"/>
      <Button Content="اختيار مجلد لعبة" Click="StartGame"/>
      <Button Content="فتح ملف للترجمة" Click="StartFile"/>
      <Button Content="تغيير مجلد المشاريع" Click="ChooseWorkspace"/>
     </WrapPanel>
     <TextBlock Text="المشاريع الأخيرة (انقر مرتين للفتح)" FontWeight="SemiBold" Margin="4,22,4,4" Foreground="#2F4D4A"/>
     <ListBox x:Name="RecentProjects" Margin="4,4" MinHeight="180" MaxHeight="380" MouseDoubleClick="OpenRecent" KeyDown="RecentKey" AutomationProperties.Name="المشاريع الأخيرة">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel Margin="6,4">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0"/>
         <TextBlock Text="{Binding Path}" FlowDirection="LeftToRight" FontSize="11" Foreground="#52656A" TextTrimming="CharacterEllipsis" Margin="0"/>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
   </TabItem>

   <!-- Tab 2: Overview -->
   <TabItem Header="المشروع" x:Name="Overview" IsEnabled="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="20" MaxWidth="980" HorizontalAlignment="Stretch">
      <!-- Game Identity & Primary CTA -->
      <Border Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="20">
       <StackPanel>
        <TextBlock x:Name="DashboardName" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="EngineSummary" FontSize="15" Foreground="#275D55" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="DeploymentSummary" Foreground="#496165" TextWrapping="Wrap" Margin="4,2,4,10"/>
        <WrapPanel>
         <Button x:Name="Primary" Click="PrimaryAction" Background="#17645E" Foreground="White" FontWeight="SemiBold" Padding="20,10"/>
         <Button Content="الترجمة والوكلاء" Click="GoTranslation"/>
         <Button Content="فتح المحرّر" Click="GoEditor"/>
         <Button x:Name="DashboardTrial" Content="جرّب داخل اللعبة" Click="TryGame" Visibility="Collapsed"/>
        </WrapPanel>
       </StackPanel>
      </Border>

      <!-- Progress & Counters -->
      <Border Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
       <StackPanel>
        <DockPanel Margin="0,0,0,6">
         <TextBlock Text="تقدّم التعريب" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Right"/>
         <TextBlock x:Name="ApprovalPercent" FontSize="15" FontWeight="SemiBold" Foreground="#17645E" HorizontalAlignment="Left"/>
        </DockPanel>
        <ProgressBar x:Name="ApprovalProgress" Height="8" Foreground="#24867A" Background="#E4ECEA" AutomationProperties.Name="نسبة الاعتماد"/>
        <UniformGrid Columns="4" Margin="0,12,0,4">
         <Button x:Name="PendingCount" Tag="pending" Click="OpenStatus" Background="#F4F6F5" Foreground="#2C3E50" FontWeight="SemiBold"/>
         <Button x:Name="DraftCount" Tag="review" Click="OpenStatus" Background="#FFF8E6" Foreground="#8A5A00" FontWeight="SemiBold"/>
         <Button x:Name="IssueCount" Tag="issues" Click="OpenStatus" Background="#FDEDEC" Foreground="#A93226" FontWeight="SemiBold"/>
         <Button x:Name="ApprovedCount" Tag="approved" Click="OpenStatus" Background="#E8F8F5" Foreground="#146356" FontWeight="SemiBold"/>
        </UniformGrid>
       </StackPanel>
      </Border>

      <!-- Lifetime Project Token & Cost Summary Card -->
      <Border x:Name="OverviewUsageCard" Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
       <DockPanel>
        <Button Content="تفاصيل الاستهلاك والأسعار" Click="OpenUsagePanel" DockPanel.Dock="Left" VerticalAlignment="Center"/>
        <StackPanel>
         <TextBlock Text="إجمالي استهلاك التوكنز والتكلفة للمشروع بالكامل" FontSize="15" FontWeight="SemiBold" Foreground="#143C42" Margin="0,0,0,6"/>
         <UniformGrid Columns="3">
          <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
           <StackPanel>
            <TextBlock Text="إجمالي التوكنز" FontSize="11" Foreground="#4D6468" Margin="0"/>
            <TextBlock x:Name="OverviewTotalTokens" Text="0" FontSize="18" FontWeight="Bold" Foreground="#143C42" Margin="0,2,0,0"/>
            <TextBlock x:Name="OverviewTokensBreakdown" Text="" FontSize="11" Foreground="#5A7276" TextTrimming="CharacterEllipsis" Margin="0"/>
           </StackPanel>
          </Border>
          <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3,0">
           <StackPanel>
            <TextBlock Text="التكلفة التقديرية الكاملة" FontSize="11" Foreground="#4D6468" Margin="0"/>
            <TextBlock x:Name="OverviewTotalCost" Text="$0.00" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#146356" Margin="0,2,0,0"/>
            <TextBlock Text="قابل لتعديل السعر لكل نموذج" FontSize="11" Foreground="#5A7276" Margin="0"/>
           </StackPanel>
          </Border>
          <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,0,0">
           <StackPanel>
            <TextBlock Text="الطلبات التراكمية" FontSize="11" Foreground="#4D6468" Margin="0"/>
            <TextBlock x:Name="OverviewTotalRequests" Text="0 طلب" FontSize="16" FontWeight="Bold" Foreground="#17645E" Margin="0,2,0,0"/>
            <TextBlock Text="محفوظة عبر كل التشغيلات" FontSize="11" Foreground="#5A7276" Margin="0"/>
           </StackPanel>
          </Border>
         </UniformGrid>
        </StackPanel>
       </DockPanel>
      </Border>

      <!-- Smart Drafts Banner (visible whenever drafts > 0) -->
      <Border x:Name="DraftsActionPanel" Background="#FFFBF0" BorderBrush="#F0D58C" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
       <StackPanel>
        <TextBlock x:Name="DraftsActionTitle" FontWeight="SemiBold" Foreground="#7A5200" TextWrapping="Wrap"/>
        <TextBlock Text="لست مضطراً لمراجعة آلاف الأسطر يدوياً: أرسلها للوكيل المراجع بالذكاء الاصطناعي ليدقّقها ويعتمدها تلقائياً، أو اعتمد كل السليمة بنقرة واحدة." Foreground="#6B5A32" FontSize="13" TextWrapping="Wrap" Margin="4,2,4,8"/>
        <WrapPanel>
         <Button Content="مراجعة المسودات بالذكاء الاصطناعي" Click="ReviewDraftsWithAi" Background="#17645E" Foreground="White" FontWeight="SemiBold"/>
         <Button Content="اعتماد كل المسودات السليمة دفعة واحدة" Click="ApproveAllDrafts"/>
        </WrapPanel>
       </StackPanel>
      </Border>

      <!-- Pre-Translation File Quality Guard Banner -->
      <Border x:Name="FilesGuardBanner" Background="#F4F9F8" BorderBrush="#BBD7D0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
       <DockPanel>
        <Button Content="مراجعة الملفات والعينات" Click="GoFiles" DockPanel.Dock="Left" VerticalAlignment="Center"/>
        <StackPanel>
         <TextBlock x:Name="FilesGuardTitle" FontWeight="SemiBold" Foreground="#144D46" TextWrapping="Wrap"/>
         <TextBlock x:Name="FilesGuardDetail" Foreground="#436064" FontSize="13" TextWrapping="Wrap" Margin="4,2,4,0"/>
        </StackPanel>
       </DockPanel>
      </Border>

      <!-- Compact Project Status -->
      <Border Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock x:Name="OverviewTeam" TextWrapping="Wrap" FontWeight="Medium"/>
        <TextBlock x:Name="ScanSummary" TextWrapping="Wrap" Foreground="#496165"/>
        <TextBlock x:Name="OutputSummary" TextWrapping="Wrap" Foreground="#496165"/>
        <WrapPanel Margin="0,6,0,0">
         <Button x:Name="DashboardPreview" Content="بناء معاينة" Click="PreviewFromProject"/>
         <Button x:Name="OpenLatest" Content="فتح مجلد آخر ناتج" Click="OpenOutput"/>
         <Button Content="الحزم والتجربة" Click="GoPackages"/>
         <Button Content="الملفات والفحص" Click="GoFiles"/>
        </WrapPanel>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <!-- Tab 3: Unified Translation & Live Agents Monitor -->
   <TabItem Header="الترجمة والوكلاء" x:Name="TranslationPage" IsEnabled="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="18" MaxWidth="1060" HorizontalAlignment="Stretch">

      <!-- Unified Start & Speed Controls -->
      <Border Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="18">
       <StackPanel x:Name="TranslationControlsPanel">
        <DockPanel Margin="0,0,0,8">
         <StackPanel DockPanel.Dock="Right">
          <TextBlock Text="التحكّم بالترجمة والوكلاء" FontSize="21" FontWeight="SemiBold" Margin="0"/>
          <TextBlock x:Name="ProviderSummary" Foreground="#275D55" FontWeight="Medium" TextWrapping="Wrap" Margin="0,2,0,0"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Button Content="توزيع النماذج والوكلاء" Click="ToggleRoutingPanel"/>
          <Button Content="إعداد المزوّد والـ API" Click="ToggleConnectionPanel"/>
         </StackPanel>
        </DockPanel>

        <!-- Mode & Scope Row -->
        <WrapPanel Margin="0,4">
         <StackPanel Margin="0,0,12,0">
          <TextBlock Text="ماذا نُعالج؟" FontSize="12" Foreground="#4D6468"/>
          <ComboBox x:Name="TranslationMode" Width="270" SelectedIndex="0" SelectedValuePath="Tag">
           <ComboBoxItem Content="كل النصوص المتبقية في المشروع" Tag="all-pending"/>
           <ComboBoxItem Content="مراجعة المسودات القائمة بالذكاء الاصطناعي" Tag="review-drafts"/>
           <ComboBoxItem Content="النطاق المفلتر حالياً في المحرّر" Tag="editor-scope"/>
          </ComboBox>
         </StackPanel>
         <StackPanel Margin="0,0,12,0">
          <TextBlock Text="أسلوب العمل" FontSize="12" Foreground="#4D6468"/>
          <ComboBox x:Name="SpeedMode" Width="280" SelectedIndex="0" SelectedValuePath="Tag">
           <ComboBoxItem Content="فريق كامل (ترجمة + مراجعة AI + تصحيح)" Tag="team"/>
           <ComboBoxItem Content="وضع سريع (مترجمون متوازون + فحص محلي)" Tag="fast"/>
          </ComboBox>
         </StackPanel>
         <StackPanel Margin="0,0,12,0">
          <TextBlock Text="عدد الوكلاء المتوازين" FontSize="12" Foreground="#4D6468"/>
          <ComboBox x:Name="WorkersCount" Width="170" SelectedIndex="2" SelectedValuePath="Tag" SelectionChanged="WorkersCountChanged">
           <ComboBoxItem Content="1 وكيل" Tag="1"/>
           <ComboBoxItem Content="2 وكيلان" Tag="2"/>
           <ComboBoxItem Content="4 وكلاء (موصى به)" Tag="4"/>
           <ComboBoxItem Content="6 وكلاء" Tag="6"/>
           <ComboBoxItem Content="8 وكلاء" Tag="8"/>
           <ComboBoxItem Content="12 وكيلاً (سريع)" Tag="12"/>
           <ComboBoxItem Content="16 وكيلاً (أقصى سرعة)" Tag="16"/>
          </ComboBox>
         </StackPanel>
         <StackPanel>
          <TextBlock Text="حجم الدفعة" FontSize="12" Foreground="#4D6468"/>
          <ComboBox x:Name="BatchSizeChoice" Width="160" SelectedIndex="1" SelectedValuePath="Tag">
           <ComboBoxItem Content="15 نصاً / دفعة" Tag="15"/>
           <ComboBoxItem Content="30 نصاً / دفعة (موصى)" Tag="30"/>
           <ComboBoxItem Content="45 نصاً / دفعة" Tag="45"/>
           <ComboBoxItem Content="60 نصاً / دفعة" Tag="60"/>
          </ComboBox>
         </StackPanel>
        </WrapPanel>

        <WrapPanel Margin="0,4">
         <CheckBox x:Name="AutoApproveReviewed" IsChecked="True" Content="اعتماد الترجمات السليمة تلقائياً (لا حاجة لمراجعتها يدوياً)"/>
         <CheckBox x:Name="UnlimitedBudget" IsChecked="True" Content="بلا سقف (أكمل حتى نهاية النطاق دون توقف)"/>
        </WrapPanel>
        <TextBlock x:Name="ScopeSummary" FontSize="12" Foreground="#5B7074" TextWrapping="Wrap"/>
        <DockPanel Margin="0,2,0,0">
         <Button Content="اختيار الملفات ومعاينتها" Click="GoFiles" DockPanel.Dock="Left" Padding="10,4" FontSize="12"/>
         <TextBlock x:Name="TranslationFilesGuardText" FontSize="12" Foreground="#1F5952" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Clear Primary Action Buttons -->
        <WrapPanel Margin="0,8,0,0">
         <Button x:Name="ResumeTeamPrimary" Content="استأنف التشغيل المحفوظ" Click="ResumeTeamQuick" Background="#17645E" Foreground="White" FontWeight="SemiBold" Padding="18,10" Visibility="Collapsed"/>
         <Button x:Name="StartTranslationPrimary" Content="ابدأ الترجمة الآن" Click="StartUnifiedTranslation" Background="#17645E" Foreground="White" FontWeight="SemiBold" Padding="18,10"/>
         <Button Content="تجربة 3 نصوص" Click="TranslateSample"/>
         <Button x:Name="TeamNotesButton" Content="ملاحظات الفريق" Click="ShowTeamNotes"/>
         <Button x:Name="ApproveTeamDraftsButton" Content="اعتماد كل المسودات السليمة" Click="ApproveAllDrafts"/>
        </WrapPanel>
       </StackPanel>
      </Border>

      <!-- Live Agent & Token Telemetry Monitor (ALWAYS interactive while running!) -->
      <Border x:Name="LiveMonitorCard" Background="White" BorderBrush="#BFD4CE" BorderThickness="1.5" CornerRadius="10" Padding="18" Margin="0,14,0,0">
       <StackPanel>
        <DockPanel Margin="0,0,0,8">
         <StackPanel DockPanel.Dock="Right">
          <TextBlock x:Name="LiveMonitorTitle" Text="لوحة مراقبة الوكلاء والتوكنز" FontSize="18" FontWeight="SemiBold" Margin="0"/>
          <TextBlock x:Name="SavedTeamSummary" Foreground="#496165" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Button Content="فتح ملف السجل (Log)" Click="OpenLiveLog"/>
          <Button x:Name="StopTranslationButton" Content="إيقاف مؤقت (يحفظ المنجز)" Click="CancelWork" Background="#C0392B" Foreground="White" FontWeight="SemiBold" Visibility="Collapsed"/>
         </StackPanel>
        </DockPanel>

        <!-- Determinate Progress -->
        <DockPanel Margin="0,2,0,4">
         <TextBlock x:Name="LiveProgressText" Text="جاهز للتشغيل" FontWeight="SemiBold" Foreground="#17645E" DockPanel.Dock="Right"/>
         <TextBlock x:Name="LiveEtaText" Text="" Foreground="#52656A" HorizontalAlignment="Left"/>
        </DockPanel>
        <ProgressBar x:Name="LiveProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#1F8A7C" Background="#E4ECEA"/>

        <!-- 4 Live KPI Cards -->
        <UniformGrid Columns="4" Margin="0,12,0,10">
         <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3">
          <StackPanel>
           <TextBlock Text="التوكنز (Tokens)" FontSize="12" Foreground="#4D6468" Margin="0"/>
           <TextBlock x:Name="LiveTokensTotal" Text="0" FontSize="20" FontWeight="Bold" Foreground="#143C42" Margin="0,2,0,0"/>
           <TextBlock x:Name="LiveTokensBreakdown" Text="دخل: 0 · خرج: 0" FontSize="11" Foreground="#5A7276" Margin="0"/>
          </StackPanel>
         </Border>
         <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3">
          <StackPanel>
           <TextBlock Text="السرعة والطلبات" FontSize="12" Foreground="#4D6468" Margin="0"/>
           <TextBlock x:Name="LiveSpeedText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#143C42" Margin="0,2,0,0"/>
           <TextBlock x:Name="LiveRequestsText" Text="0 طلب" FontSize="11" Foreground="#5A7276" Margin="0"/>
          </StackPanel>
         </Border>
         <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3">
          <StackPanel>
           <TextBlock Text="الترجمات المحفوظة" FontSize="12" Foreground="#4D6468" Margin="0"/>
           <TextBlock x:Name="LiveSavedText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#146356" Margin="0,2,0,0"/>
           <TextBlock x:Name="LiveNotesCountText" Text="ملاحظات: 0" FontSize="11" Foreground="#5A7276" Margin="0"/>
          </StackPanel>
         </Border>
         <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3">
          <StackPanel>
           <TextBlock Text="الوكلاء النشطون" FontSize="12" Foreground="#4D6468" Margin="0"/>
           <TextBlock x:Name="LiveActiveAgentsText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#17645E" Margin="0,2,0,0"/>
           <TextBlock x:Name="LiveModeBadge" Text="في وضع الانتظار" FontSize="11" Foreground="#5A7276" Margin="0"/>
          </StackPanel>
         </Border>
        </UniformGrid>

        <!-- Live Agents Table -->
        <TextBlock Text="الوكلاء وأدوارهم الآن" FontWeight="SemiBold" Foreground="#27464A" Margin="2,4,2,4"/>
        <DataGrid x:Name="AgentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" MaxHeight="220" Background="White" BorderBrush="#DCE4E1" FontSize="13">
         <DataGrid.Columns>
          <DataGridTextColumn Header="الوكيل" Binding="{Binding AgentName}" Width="92"/>
          <DataGridTextColumn Header="الدور الحالي" Binding="{Binding Role}" Width="105"/>
          <DataGridTextColumn Header="النموذج / API" Binding="{Binding ModelLabel}" Width="185">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="FlowDirection" Value="LeftToRight"/>
             <Setter Property="VerticalAlignment" Value="Center"/>
             <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
             <Setter Property="Foreground" Value="#215B53"/>
             <Setter Property="ToolTip" Value="{Binding ModelLabel}"/>
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="الحالة" Binding="{Binding Stage}" Width="82"/>
          <DataGridTextColumn Header="الدفعة" Binding="{Binding BatchLabel}" Width="68"/>
          <DataGridTextColumn Header="المنجز" Binding="{Binding CompletedCount}" Width="66"/>
          <DataGridTextColumn Header="التفاصيل الآن" Binding="{Binding Detail}" Width="*"/>
         </DataGrid.Columns>
        </DataGrid>

        <!-- Live Activity Feed -->
        <Expander x:Name="ActivityFeedExpander" Header="سجل النشاط المباشر" IsExpanded="False" Margin="0,10,0,0">
         <ListBox x:Name="ActivityLog" MaxHeight="160" BorderThickness="0" FontSize="12" Foreground="#2F494D"/>
        </Expander>
       </StackPanel>
      </Border>

      <!-- Lifetime Project Usage & Cost Ledger -->
      <Expander Header="إجمالي استهلاك اللعبة والتكلفة ($) لكل نموذج" x:Name="UsageCostPanel">
       <StackPanel Margin="4">
        <UniformGrid Columns="3" Margin="0,2,0,10">
         <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3">
          <StackPanel>
           <TextBlock Text="إجمالي توكنز اللعبة بالكامل" FontSize="12" Foreground="#4D6468" Margin="0"/>
           <TextBlock x:Name="UsageSummaryTokens" Text="0" FontSize="20" FontWeight="Bold" Foreground="#143C42" Margin="0,2,0,0"/>
           <TextBlock x:Name="UsageSummaryBreakdown" Text="دخل: 0 · خرج: 0" FontSize="11" Foreground="#5A7276" Margin="0"/>
          </StackPanel>
         </Border>
         <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3">
          <StackPanel>
           <TextBlock Text="إجمالي التكلفة التقديرية" FontSize="12" Foreground="#4D6468" Margin="0"/>
           <TextBlock x:Name="UsageSummaryCost" Text="$0.00" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#146356" Margin="0,2,0,0"/>
           <TextBlock x:Name="UsageSummaryCostHint" Text="تقديري حسب أسعار النماذج" FontSize="11" Foreground="#5A7276" Margin="0"/>
          </StackPanel>
         </Border>
         <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3">
          <StackPanel>
           <TextBlock Text="إجمالي الطلبات المسجّلة" FontSize="12" Foreground="#4D6468" Margin="0"/>
           <TextBlock x:Name="UsageSummaryRequests" Text="0 طلب" FontSize="20" FontWeight="Bold" Foreground="#17645E" Margin="0,2,0,0"/>
           <TextBlock Text="تراكمي ولا يُمسح عند بدء تشغيل جديد" FontSize="11" Foreground="#5A7276" Margin="0"/>
          </StackPanel>
         </Border>
        </UniformGrid>

        <DataGrid x:Name="UsageLedgerGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32" MaxHeight="200" Background="White" BorderBrush="#DCE4E1" FontSize="12" SelectionChanged="SelectUsageRow">
         <DataGrid.Columns>
          <DataGridTextColumn Header="النموذج" Binding="{Binding Model}" Width="1.6*">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="FlowDirection" Value="LeftToRight"/>
             <Setter Property="VerticalAlignment" Value="Center"/>
             <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="الطلبات" Binding="{Binding RequestsText}" Width="66"/>
          <DataGridTextColumn Header="دخل (In)" Binding="{Binding InputText}" Width="90"/>
          <DataGridTextColumn Header="خرج (Out)" Binding="{Binding OutputText}" Width="90"/>
          <DataGridTextColumn Header="تفكير (Think)" Binding="{Binding ThinkingText}" Width="92"/>
          <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalText}" Width="96"/>
          <DataGridTextColumn Header="سعر 1M دخل" Binding="{Binding InputPriceText}" Width="88"/>
          <DataGridTextColumn Header="سعر 1M خرج" Binding="{Binding OutputPriceText}" Width="88"/>
          <DataGridTextColumn Header="التكلفة ($)" Binding="{Binding CostText}" Width="84">
           <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
             <Setter Property="FlowDirection" Value="LeftToRight"/>
             <Setter Property="VerticalAlignment" Value="Center"/>
             <Setter Property="FontWeight" Value="Bold"/>
             <Setter Property="Foreground" Value="#146356"/>
            </Style>
           </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
         </DataGrid.Columns>
        </DataGrid>

        <Border Background="#F7FBFA" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
         <StackPanel>
          <TextBlock Text="تعديل سعر النموذج (بالدولار لكل 1 مليون توكن — توكنز التفكير تُحسب بسعر الخرج):" FontSize="12" Foreground="#375B55" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <WrapPanel>
           <TextBlock Text="النموذج" VerticalAlignment="Center" FontSize="12"/>
           <TextBox x:Name="PriceModelInput" Width="210" FlowDirection="LeftToRight" ToolTip="اختر صفاً من الجدول أعلاه أو اكتب اسم النموذج"/>
           <TextBlock Text="سعر 1M دخل ($)" VerticalAlignment="Center" FontSize="12"/>
           <TextBox x:Name="PriceInputPerMillion" Width="78" FlowDirection="LeftToRight" ToolTip="مثال: 0.30"/>
           <TextBlock Text="سعر 1M خرج ($)" VerticalAlignment="Center" FontSize="12"/>
           <TextBox x:Name="PriceOutputPerMillion" Width="78" FlowDirection="LeftToRight" ToolTip="مثال: 2.50"/>
           <Button Content="حفظ السعر" Click="SaveModelPrice" Background="#17645E" Foreground="White"/>
           <Button Content="افتراضي" Click="ResetModelPrice"/>
          </WrapPanel>
         </StackPanel>
        </Border>
       </StackPanel>
      </Expander>

      <!-- Collapsible Settings Expanders -->
      <Expander Header="اتصالات الـ API والنماذج المحفوظة" x:Name="ConnectionPanel">
       <StackPanel Margin="4">
        <Border Background="#F4FAF8" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
         <StackPanel>
          <TextBlock Text="ملفات الاتصال المحفوظة (يمكنك حفظ أكثر من API وتوزيعها على الفرق أو الوكلاء)" FontSize="12" Foreground="#375B55" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <WrapPanel>
           <ComboBox x:Name="ProfileSelector" Width="210" DisplayMemberPath="Name" SelectionChanged="SelectProviderProfile" AutomationProperties.Name="ملف الاتصال المحفوظ"/>
           <TextBox x:Name="ProfileNameInput" Width="185" ToolTip="اسم ملف الاتصال (مثال: DeepSeek أو Gemini Proxy)" AutomationProperties.Name="اسم ملف الاتصال"/>
           <Button Content="+ اتصال جديد" Click="AddProviderProfile"/>
           <Button x:Name="DeleteProfileButton" Content="حذف الاتصال" Click="DeleteProviderProfile"/>
          </WrapPanel>
         </StackPanel>
        </Border>
        <TextBlock Text="المزوّد"/>
        <ComboBox x:Name="Provider" SelectedIndex="0">
         <ComboBoxItem Content="openai-compatible"/>
         <ComboBoxItem Content="gemini"/>
         <ComboBoxItem Content="anthropic"/>
         <ComboBoxItem Content="deepseek"/>
         <ComboBoxItem Content="azure"/>
        </ComboBox>
        <TextBlock Text="عنوان API اختياري للخادم المحلي أو المخصّص"/>
        <TextBox x:Name="ApiUrl" FlowDirection="LeftToRight"/>
        <Expander x:Name="CertificateOptions" Header="شهادة HTTPS الخاصة" Margin="0,4">
         <StackPanel>
          <TextBlock Text="بصمة SHA-256 لشهادة الخادم، بعد التحقق منها على الخادم" TextWrapping="Wrap"/>
          <TextBox x:Name="CertificateSha256" FlowDirection="LeftToRight" AutomationProperties.Name="بصمة SHA-256 لشهادة الخادم"/>
         </StackPanel>
        </Expander>
        <CheckBox x:Name="JsonMode" Content="فرض صيغة JSON (response_format)" Margin="6,4"/>
        <TextBlock Text="مفتاح API"/>
        <PasswordBox x:Name="ApiKey"/>
        <StackPanel x:Name="ModelPicker">
         <TextBlock Text="النموذج الافتراضي لهذا الاتصال"/>
         <DockPanel>
          <Button x:Name="FetchModelsButton" DockPanel.Dock="Left" Content="جلب النماذج" Click="FetchModels"/>
          <ComboBox x:Name="Model" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="260" FlowDirection="LeftToRight" AutomationProperties.Name="النموذج"/>
         </DockPanel>
         <TextBlock x:Name="ModelListStatus" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>
        <WrapPanel>
         <CheckBox x:Name="KeepApiKey" Content="حفظ المفتاح في Windows" VerticalAlignment="Center"/>
         <Button Content="حفظ ملف الاتصال" Click="SaveProvider" Background="#17645E" Foreground="White"/>
         <Button Content="إزالة المفتاح المحفوظ" Click="ForgetProviderKey"/>
        </WrapPanel>
        <TextBlock Text="منطقة Azure (عند اختيار Azure فقط)"/>
        <TextBox x:Name="Region"/>
       </StackPanel>
      </Expander>

      <Expander Header="توزيع النماذج والـ API على الفرق والوكلاء (اختياري)" x:Name="RoutingPanel">
       <StackPanel Margin="4">
        <TextBlock Text="يمكنك تشغيل كل فريق بنموذج أو API مختلف (مثال: المترجم بنموذج سريع والمراجع بنموذج أدق)، أو تخصيص كل وكيل على حدة. التغييرات تُطبّق فوراً حتى عند استئناف تشغيل محفوظ." FontSize="12" Foreground="#4D6468" TextWrapping="Wrap" Margin="4,2,4,8"/>

        <!-- Per-Role Routing -->
        <TextBlock Text="1. توزيع حسب الدور (لكل فريق)" FontWeight="SemiBold" Foreground="#174945" Margin="4,2,4,4"/>
        <Grid Margin="4,0,4,8">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="230"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <TextBlock Grid.Row="0" Grid.Column="0" Text="الفريق / الدور" FontSize="12" FontWeight="SemiBold" Foreground="#4D6468"/>
         <TextBlock Grid.Row="0" Grid.Column="1" Text="ملف الاتصال (API)" FontSize="12" FontWeight="SemiBold" Foreground="#4D6468"/>
         <TextBlock Grid.Row="0" Grid.Column="2" Text="النموذج (اتركه فارغاً لاستخدام افتراضي الاتصال)" FontSize="12" FontWeight="SemiBold" Foreground="#4D6468"/>

         <TextBlock Grid.Row="1" Grid.Column="0" Text="فريق المترجمين" VerticalAlignment="Center" FontWeight="Medium"/>
         <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TranslatorProfileInput" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="RoleProfileChanged"/>
         <ComboBox Grid.Row="1" Grid.Column="2" x:Name="TranslatorModelInput" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="240" FlowDirection="LeftToRight" LostFocus="RoutingFieldChanged" SelectionChanged="RoutingFieldChanged"/>

         <TextBlock Grid.Row="2" Grid.Column="0" Text="فريق المراجعين" VerticalAlignment="Center" FontWeight="Medium"/>
         <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ReviewerProfileInput" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="RoleProfileChanged"/>
         <ComboBox Grid.Row="2" Grid.Column="2" x:Name="ReviewerModelInput" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="240" FlowDirection="LeftToRight" LostFocus="RoutingFieldChanged" SelectionChanged="RoutingFieldChanged"/>

         <TextBlock Grid.Row="3" Grid.Column="0" Text="المشرف (التخطيط)" VerticalAlignment="Center" FontWeight="Medium"/>
         <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SupervisorProfileInput" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="RoleProfileChanged"/>
         <ComboBox Grid.Row="3" Grid.Column="2" x:Name="SupervisorModelInput" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="240" FlowDirection="LeftToRight" LostFocus="RoutingFieldChanged" SelectionChanged="RoutingFieldChanged"/>
        </Grid>

        <!-- Per-Worker Individual Override -->
        <CheckBox x:Name="EnablePerWorkerRouting" Content="2. تخصيص فردي لكل وكيل (تعيين API أو نموذج مختلف لوكيل #1، #2، …)" FontWeight="SemiBold" Foreground="#174945" Checked="TogglePerWorkerRouting" Unchecked="TogglePerWorkerRouting" Margin="4,6,4,4"/>
        <Border x:Name="PerWorkerRoutingContainer" Visibility="Collapsed" Background="#F7FBFA" BorderBrush="#D6E6E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,2,4,8">
         <StackPanel>
          <TextBlock Text="أي وكيل تتركه على «حسب الدور» سيستخدم إعداد الفريق أعلاه تلقائياً." FontSize="12" Foreground="#52696D" Margin="0,0,0,6"/>
          <Grid Margin="0,0,0,4">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95"/>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
           </Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="الوكيل" FontSize="12" FontWeight="SemiBold" Foreground="#4D6468"/>
           <TextBlock Grid.Column="1" Text="ملف الاتصال (API)" FontSize="12" FontWeight="SemiBold" Foreground="#4D6468"/>
           <TextBlock Grid.Column="2" Text="النموذج المخصّص لهذا الوكيل" FontSize="12" FontWeight="SemiBold" Foreground="#4D6468"/>
          </Grid>
          <ItemsControl x:Name="WorkerRoutingList">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
               <ColumnDefinition Width="95"/>
               <ColumnDefinition Width="230"/>
               <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding AgentName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#174945"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedProfile, Mode=TwoWay}" Margin="3,2"/>
              <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableModels}" Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="220" FlowDirection="LeftToRight" Margin="3,2"/>
             </Grid>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </Border>

        <WrapPanel Margin="2,4,2,0">
         <Button Content="حفظ توزيع النماذج للمشروع" Click="SaveTeamRoleSettings" Background="#17645E" Foreground="White"/>
         <Button Content="مسح التخصيص (الكل افتراضي)" Click="ResetRoutingSettings"/>
        </WrapPanel>
       </StackPanel>
      </Expander>

      <Expander Header="تعليمات الأسلوب والأدوار (Prompts)" x:Name="RolesPanel">
       <StackPanel Margin="4">
        <TextBlock Text="أسلوب الترجمة للمشروع (مثال: فصحى معاصرة موجزة للأزرار وطبيعية للحوار)" FontSize="12" Foreground="#4D6468"/>
        <TextBox x:Name="TeamStyleInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
        <TextBlock Text="تعليمات إضافية للمشرف / المترجم / المراجع (اختياري)" FontSize="12" Foreground="#4D6468"/>
        <UniformGrid Columns="3">
         <TextBox x:Name="SupervisorPromptInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" ToolTip="تعليمات المشرف"/>
         <TextBox x:Name="TranslatorPromptInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" ToolTip="تعليمات المترجم"/>
         <TextBox x:Name="ReviewerPromptInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" ToolTip="تعليمات المراجع"/>
        </UniformGrid>
        <WrapPanel>
         <Button Content="حفظ إعدادات الأدوار" Click="SaveTeamRoleSettings"/>
         <Button Content="معاينة التعليمات الكاملة" Click="PreviewTeamPrompts"/>
         <Button Content="استعادة القوالب الافتراضية" Click="ResetTeamRoleSettings"/>
        </WrapPanel>
       </StackPanel>
      </Expander>

      <Expander Header="حدود الميزانية المتقدمة (تُطبّق عند إيقاف خيار «بلا سقف»)" x:Name="BudgetPanel">
       <StackPanel Margin="4">
        <WrapPanel>
         <TextBlock Text="حد الأحرف" VerticalAlignment="Center"/>
         <TextBox x:Name="CharacterBudget" Text="500000" Width="120"/>
         <TextBlock Text="حد الطلبات" VerticalAlignment="Center"/>
         <TextBox x:Name="RequestBudget" Text="500" Width="95"/>
         <Button Content="تقدير حدود الاستئناف" Click="EstimateTeamBudget"/>
         <Button Content="تقدير حجم النطاق" Click="Estimate"/>
         <Button Content="استئناف دفعة فردية سابقة" Click="ResumeTranslation"/>
        </WrapPanel>
       </StackPanel>
      </Expander>

      <Expander x:Name="SectionsPanel" Header="تقدّم الأقسام" Expanded="ShowSections">
       <ListBox x:Name="SectionList" MaxHeight="180" BorderThickness="0"/>
      </Expander>

      <Expander Header="مصطلحات المشروع (المعجم)" x:Name="GlossaryPanel">
       <StackPanel Margin="4">
        <ListBox x:Name="Terms" DisplayMemberPath="Key" SelectionChanged="OpenTerm" MinHeight="70" MaxHeight="120"/>
        <UniformGrid Columns="2">
         <StackPanel>
          <TextBlock Text="المصطلح الأصلي"/>
          <TextBox x:Name="TermSource" FlowDirection="LeftToRight"/>
         </StackPanel>
         <StackPanel>
          <TextBlock Text="الترجمة المعتمدة للمصطلح"/>
          <TextBox x:Name="TermTarget"/>
         </StackPanel>
        </UniformGrid>
        <WrapPanel>
         <Button Content="حفظ المصطلح" Click="SaveTerm"/>
         <Button Content="حذف المصطلح المحدد" Click="DeleteTerm"/>
        </WrapPanel>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <!-- Tab 4: Streamlined Editor -->
   <TabItem Header="المحرّر" x:Name="EditorPage" IsEnabled="False">
    <Grid Margin="12">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <!-- Single Clean Toolbar Row -->
     <WrapPanel Margin="0,0,0,6">
      <TextBox x:Name="Search" Width="180" AutomationProperties.Name="بحث في النصوص" KeyDown="SearchKey" ToolTip="ابحث في الأصل أو العربية أو المسار"/>
      <ComboBox x:Name="ReviewFilter" Width="138" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="ChangeReviewFilter">
       <ComboBoxItem Content="كل الحالات" Tag=""/>
       <ComboBoxItem Content="بانتظار الترجمة" Tag="pending"/>
       <ComboBoxItem Content="للمراجعة" Tag="review"/>
       <ComboBoxItem Content="تحتاج انتباهاً" Tag="issues"/>
       <ComboBoxItem Content="معتمدة" Tag="approved"/>
       <ComboBoxItem Content="المسودات" Tag="translated"/>
       <ComboBoxItem Content="التعارضات" Tag="conflict"/>
      </ComboBox>
      <Button Content="بحث" Click="SearchRows"/>
      <Button Content="السابق" Click="Previous"/>
      <Button Content="التالي" Click="Next"/>
      <Button Content="حفظ" Click="SaveSelected"/>
      <Button Content="اعتماد المحدّد" Click="ApproveSelected" Background="#17645E" Foreground="White"/>
      <Button Content="اعتماد كل المسودات السليمة" Click="ApproveAllDrafts"/>
      <Button x:Name="EditorTrial" Content="جرّب داخل اللعبة" Click="TryGame" Visibility="Collapsed"/>
      <Menu Background="Transparent" VerticalAlignment="Center">
       <MenuItem Header="أدوات إضافية ▾" Padding="10,7">
        <MenuItem Header="ترجم الصفوف المحددة" Click="TranslateSelected"/>
        <MenuItem Header="إعادة ترجمة السطر المحدد" Click="Retranslate"/>
        <MenuItem Header="اقتراح من ذاكرة الترجمة" Click="SuggestMemory"/>
        <MenuItem Header="إضافة/عرض المصطلحات" Click="OpenGlossary"/>
        <Separator/>
        <MenuItem Header="اعتماد الصفحة الحالية فقط" Click="ApprovePage"/>
        <Separator/>
        <MenuItem Header="تصدير النطاق إلى CSV" Click="ExportReview"/>
        <MenuItem Header="استيراد مراجعة CSV" Click="ImportReview"/>
        <MenuItem Header="نسخ المشروع احتياطياً" Click="BackupProject"/>
       </MenuItem>
      </Menu>
     </WrapPanel>

     <DataGrid Grid.Row="1" x:Name="Rows" RowEditEnding="SaveRowAfterEdit" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="68" FontSize="14" Background="White" Foreground="#14202E" AlternatingRowBackground="#F2F7F6" BorderBrush="#D2DFDC">
      <DataGrid.Columns>
       <DataGridTextColumn Header="المصدر" Binding="{Binding Source}" IsReadOnly="True" Width="*">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock">
          <Setter Property="FlowDirection" Value="LeftToRight"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="Padding" Value="8,6"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="العربية" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="1.4*">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock">
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="FlowDirection" Value="RightToLeft"/>
          <Setter Property="Padding" Value="8,6"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTemplateColumn Header="الحالة" IsReadOnly="True" Width="95">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <TextBlock Margin="6" VerticalAlignment="Center">
           <TextBlock.Style>
            <Style TargetType="TextBlock">
             <Setter Property="Text" Value="{Binding Status}"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding Status}" Value="pending"><Setter Property="Text" Value="بانتظار الترجمة"/></DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="translated"><Setter Property="Text" Value="للمراجعة"/><Setter Property="Foreground" Value="#8A5A00"/></DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="imported"><Setter Property="Text" Value="مستوردة"/></DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="approved"><Setter Property="Text" Value="معتمدة"/><Setter Property="Foreground" Value="#146356"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="conflict"><Setter Property="Text" Value="تعارض"/><Setter Property="Foreground" Value="#A93226"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
             </Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="تنبيه" Binding="{Binding Warning}" IsReadOnly="True" Width="0.7*"/>
      </DataGrid.Columns>
     </DataGrid>

     <StackPanel Grid.Row="2" Margin="0,4,0,0">
      <TextBlock x:Name="PageInfo" Foreground="#304C43"/>
      <Expander Header="تفاصيل النص المحدد">
       <StackPanel MaxHeight="96">
        <TextBox FlowDirection="LeftToRight" IsReadOnly="True" Text="{Binding SelectedItem.Path, ElementName=Rows, Mode=OneWay}"/>
        <WrapPanel>
         <TextBlock Text="{Binding SelectedItem.Locator, ElementName=Rows}" FlowDirection="LeftToRight"/>
         <TextBlock Text="{Binding SelectedItem.Context, ElementName=Rows}"/>
         <TextBlock Text="{Binding SelectedItem.ImportedTarget, ElementName=Rows}" ToolTip="ترجمة الملف"/>
        </WrapPanel>
       </StackPanel>
      </Expander>
     </StackPanel>
    </Grid>
   </TabItem>

   <!-- Tab 5: Packages & Playtest (Clear 2-Step Layout + Font Picker) -->
   <TabItem Header="الحزم والتجربة" x:Name="PackagesPage" IsEnabled="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="20" MaxWidth="960" HorizontalAlignment="Stretch">
      <!-- Arabic Display Font Picker & Live Preview -->
      <Border Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="خط العرض العربي داخل اللعبة" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="اختر خطاً من الخطوط المدمجة وخطوط Windows، أو أضف خطك الخاص (.ttf / .otf). يُطبّق تلقائياً عند التجربة أو بناء الحزمة." Foreground="#4B6266" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,8,0,6">
         <ComboBox x:Name="DisplayFontSelector" Width="410" DisplayMemberPath="DisplayName" SelectionChanged="SelectDisplayFont" AutomationProperties.Name="خط العرض العربي"/>
         <Button Content="+ إضافة خط خاص (.ttf / .otf)" Click="AddCustomFont" Background="#17645E" Foreground="White"/>
         <Button x:Name="DeleteCustomFontButton" Content="حذف الخط الخاص" Click="DeleteCustomFont" IsEnabled="False"/>
        </WrapPanel>
        <TextBlock x:Name="FontCompatibilityStatus" FontSize="12" FontWeight="SemiBold" Foreground="#146356" Margin="4,0,4,6"/>
        <Border Background="#11262E" BorderBrush="#244854" BorderThickness="1" CornerRadius="8" Padding="14,10">
         <StackPanel>
          <TextBlock x:Name="FontPreviewTitle" Text="معاينة مباشرة للخط داخل اللعبة — تحميل اللعبة · لعبة جديدة · الإعدادات" Foreground="#F4C542" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="FontPreviewBody" Text="اضغط للاستمرار · حفظ التقدّم · ملخص التحديث · خروج من اللعبة (100%)" Foreground="White" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="FontPreviewMenu" Text="القائمة الرئيسية · المهام والإنجازات · الخيارات المتقدمة · رجوع" Foreground="#C4DCE2" FontSize="13" TextWrapping="Wrap" Margin="0"/>
         </StackPanel>
        </Border>
        <Border x:Name="UnityTmpSettingsBorder" Background="#F4F8F7" BorderBrush="#D5E3DF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
         <StackPanel>
          <TextBlock Text="إعدادات العرض العربي لألعاب Unity (TextMeshPro):" FontWeight="SemiBold" Foreground="#174B45" FontSize="13" Margin="0,0,0,6"/>
          <WrapPanel>
           <TextBlock Text="التفاف الأسطر الطويلة:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,4"/>
           <ComboBox x:Name="UnityWrapModeSelector" Width="255" SelectionChanged="SelectUnityArabicSettings" Margin="0,0,14,4" AutomationProperties.Name="التفاف الأسطر العربية في Unity">
            <ComboBoxItem Tag="auto" Content="تلقائي — ذكي للبطاقات والواجهات (موصى به)"/>
            <ComboBoxItem Tag="16" Content="ضيق جداً للبطاقات الصغيرة (16 حرفاً)"/>
            <ComboBoxItem Tag="20" Content="ضيق للبطاقات (20 حرفاً)"/>
            <ComboBoxItem Tag="30" Content="متوسط (30 حرفاً)"/>
            <ComboBoxItem Tag="45" Content="واسع للحوارات (45 حرفاً)"/>
            <ComboBoxItem Tag="0" Content="إيقاف الالتفاف التلقائي"/>
           </ComboBox>
           <TextBlock Text="حجم الخط العربي:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,4"/>
           <ComboBox x:Name="UnityFontScaleSelector" Width="130" SelectionChanged="SelectUnityArabicSettings" Margin="0,0,0,4" AutomationProperties.Name="حجم الخط العربي في Unity">
            <ComboBoxItem Tag="0.70" Content="70% (صغير)"/>
            <ComboBoxItem Tag="0.75" Content="75%"/>
            <ComboBoxItem Tag="0.80" Content="80% (افتراضي)"/>
            <ComboBoxItem Tag="0.85" Content="85%"/>
            <ComboBoxItem Tag="0.90" Content="90%"/>
            <ComboBoxItem Tag="0.95" Content="95%"/>
            <ComboBoxItem Tag="1.00" Content="100% (كامل)"/>
            <ComboBoxItem Tag="1.10" Content="110% (كبير)"/>
           </ComboBox>
          </WrapPanel>
          <CheckBox x:Name="UnityArabicShapingToggle" Content="تشكيل وترتيب العربية مسبقاً لـ TextMeshPro (أوقِفه فقط إذا كانت اللعبة تدعم RTL أصلياً)" IsChecked="True" Checked="SelectUnityArabicSettings" Unchecked="SelectUnityArabicSettings" FontSize="12" Foreground="#174B45" Margin="0,4,0,2"/>
          <TextBlock Text="يمنع الالتفاف الذكي انقلاب الفقرات العربية الطويلة من أسفل لأعلى داخل بطاقات Unity TMP، ويُحفظ تلقائياً للمشروع ويُطبّق عند التجربة أو التثبيت الدائم." FontSize="11" Foreground="#4B6266" TextWrapping="Wrap" Margin="0,2,0,0"/>
         </StackPanel>
        </Border>
        <Border x:Name="GettextPoTargetBorder" Visibility="Collapsed" Background="#F4F8F7" BorderBrush="#D5E3DF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
         <StackPanel>
          <TextBlock Text="تطبيق ترجمة قالب Gettext (.pot → .po):" FontWeight="SemiBold" Foreground="#174B45" FontSize="13" Margin="0,0,0,6"/>
          <ComboBox x:Name="GettextPoTargetSelector" SelectionChanged="SelectGettextPoTarget" FontSize="12" Padding="8,5" Margin="0,0,0,4" AutomationProperties.Name="هدف تصدير ملف Gettext PO"/>
          <TextBlock x:Name="GettextPoTargetHint" Text="معظم ألعاب Gettext تقرأ الترجمة من ملف (.po) مثبّت وليس من قالب (.pot) مباشرة؛ اختر استبدال إحدى اللغات المثبّتة ثم اخترها من إعدادات اللعبة، مع نسخة احتياطية كاملة للاستعادة." FontSize="11" Foreground="#4B6266" TextWrapping="Wrap" Margin="0,2,0,0"/>
         </StackPanel>
        </Border>
       </StackPanel>
      </Border>

      <Border Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="18">
       <StackPanel>
        <TextBlock Text="1. جرّب الترجمة الآن" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="يشمل جميع الترجمات السليمة والمعتمدة. عند «جرّب داخل اللعبة» تُستعاد ملفات اللعبة الأصلية تلقائياً بعد الإغلاق." Foreground="#4B6266" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,8,0,0">
         <Button x:Name="PackageTrial" Content="جرّب داخل اللعبة" Click="TryGame" Background="#17645E" Foreground="White" FontWeight="SemiBold" Padding="18,10" Visibility="Collapsed"/>
         <Button Content="بناء حزمة تجربة (معاينة)" Click="BuildPreview"/>
        </WrapPanel>
       </StackPanel>
      </Border>

      <Border Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="2. التثبيت النهائي الذكي داخل اللعبة" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="يتعرّف تلقائياً على مسار اللعبة وهيكل ملفاتها ويثبّت الترجمة مباشرة مع حفظ نسخة احتياطية آمنة ومؤكدة من الملفات الأصلية — يعمل مع جميع المحركات المدعومة (Unity، Unreal Engine 4/5، Godot، Ren’Py، RPG Maker، أو أي مجلد/أرشيف لعبة)." Foreground="#4B6266" TextWrapping="Wrap"/>
        <Border x:Name="DirectInstallStatusBorder" Background="#F4F8F7" BorderBrush="#D5E3DF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
         <StackPanel>
          <TextBlock x:Name="DirectInstallStatusTitle" Text="الحالة: جارٍ فحص حالة التثبيت…" FontWeight="SemiBold" Foreground="#174B45" Margin="0,0,0,2"/>
          <TextBlock x:Name="DirectInstallStatusDetail" Text="" Foreground="#4B6266" FontSize="12" TextWrapping="Wrap" Margin="0"/>
         </StackPanel>
        </Border>
        <WrapPanel Margin="0,10,0,0">
         <Button x:Name="DirectInstallButton" Content="تثبيت دائم داخل اللعبة (مع نسخة احتياطية)" Click="DirectInstallGame" Background="#146356" Foreground="White" FontWeight="SemiBold" Padding="16,10"/>
         <Button x:Name="DirectRestoreButton" Content="إزالة التعريب واستعادة الأصل" Click="DirectRestoreGame" Visibility="Collapsed"/>
         <Button x:Name="AcceptGameUpdateButton" Content="اعتماد تحديث اللعبة الجديد" Click="AcceptExternalGameUpdate" Visibility="Collapsed"/>
        </WrapPanel>
       </StackPanel>
      </Border>

      <Border Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="3. التصدير النهائي للمشاركة" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="يبني حزمة نظيفة تحتوي على الأسطر المعتمدة فقط داخل مجلد مخرجات جديد، جاهزة للمشاركة أو التثبيت اليدوي." Foreground="#4B6266" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,8,0,0">
         <Button Content="بناء حزمة نهائية" Click="BuildFinal" Background="#17645E" Foreground="White" FontWeight="SemiBold"/>
         <Button Content="تصدير XUnity.AutoTranslator (BepInEx)" Click="ExportXUnity" ToolTip="تصدير الترجمات كملفات BepInEx/XUnity.AutoTranslator لألعاب Unity ذات النصوص المدمجة في الكود البرمجي"/>
         <Button Content="فتح مجلد آخر ناتج" Click="OpenOutput"/>
        </WrapPanel>
       </StackPanel>
      </Border>

      <Expander Header="التثبيت والاستعادة اليدوية (خيارات متقدمة)">
       <StackPanel Margin="4">
        <TextBlock Text="لتطبيق الحزمة يدوياً على نسخة منفصلة من اللعبة أو استعادة الملفات من إيصال سابق." Foreground="#4B6266" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,6,0,0">
         <Button Content="تثبيت على نسخة لعبة" Click="Install"/>
         <Button Content="استعادة الملفات من إيصال" Click="Restore"/>
         <Button x:Name="SteamRecoveryButton" Content="استعادة تجربة Steam" Click="RetryTrialRecovery"/>
        </WrapPanel>
       </StackPanel>
      </Expander>

      <TextBox x:Name="BuildLog" Height="150" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <!-- Tab 6: Clean Context-Aware Files Tab + Pre-Translation File Guard -->
   <TabItem Header="الملفات" x:Name="FilesPage" IsEnabled="False">
    <Grid Margin="18">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <Border Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="14">
      <StackPanel>
       <TextBlock Text="مصدر ملفات اللعبة" FontSize="17" FontWeight="SemiBold"/>
       <TextBox x:Name="SourcePath" FlowDirection="LeftToRight" IsReadOnly="True"/>
       <WrapPanel Margin="0,4,0,0">
        <Button Content="فحص الملفات" Click="Scan" Background="#17645E" Foreground="White" FontWeight="SemiBold"/>
        <Button Content="تغيير مجلد اللعبة" Click="ChooseFolder"/>
        <Button Content="اختيار ملف أو حزمة" Click="ChooseFile"/>
        <Button x:Name="LanguageButton" Content="تغيير لغة المصدر" Click="ChooseLanguage"/>
        <Button x:Name="RenpyGenerateButton" Content="توليد قوالب Ren’Py" Click="GenerateRenpy" Visibility="Collapsed"/>
       </WrapPanel>
      </StackPanel>
     </Border>

     <Expander Grid.Row="1" Header="خيارات متقدمة (الحزم وضبط الاستخراج والمحرّك)">
      <StackPanel Margin="4">
       <WrapPanel>
        <TextBlock Text="المحرك" VerticalAlignment="Center"/>
        <ComboBox x:Name="Engine" Width="150" SelectedIndex="0">
         <ComboBoxItem Content="auto"/>
         <ComboBoxItem Content="generic"/>
         <ComboBoxItem Content="godot"/>
         <ComboBoxItem Content="rpgmaker"/>
         <ComboBoxItem Content="renpy"/>
         <ComboBoxItem Content="unity"/>
         <ComboBoxItem Content="unreal"/>
        </ComboBox>
        <TextBlock Text="كلمة مرور ZIP" VerticalAlignment="Center"/>
        <PasswordBox x:Name="ZipPassword" Width="200"/>
        <Button Content="إعداد الاستخراج" Click="ConfigureExtraction"/>
        <Button Content="قدرات المصدر" Click="ShowCapabilities"/>
       </WrapPanel>
       <WrapPanel Margin="0,4,0,0">
        <Button Content="اكتشاف الحزم" Click="FindPackages"/>
        <ComboBox x:Name="PackageChoices" MinWidth="340" MaxWidth="660" DisplayMemberPath="Label"/>
        <Button Content="استخدام المحدد" Click="UsePackage"/>
       </WrapPanel>
      </StackPanel>
     </Expander>

     <!-- Pre-Translation File Guard: Checkboxes + Smart Quality Classification + Sample Preview -->
     <Border Grid.Row="2" Background="White" BorderBrush="#DCE4E1" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,0">
      <Grid>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>

       <DockPanel Margin="0,0,0,6">
        <StackPanel DockPanel.Dock="Right">
         <TextBlock Text="ملفات النصوص المكتشفة (حماية ما قبل الترجمة)" FontSize="16" FontWeight="SemiBold" Margin="0"/>
         <TextBlock x:Name="FilesSelectionSummary" Text="اضغط «فحص الملفات» لاستعراض الملفات ومعاينة نصوصها." FontSize="12" Foreground="#496165" Margin="0,2,0,0"/>
        </StackPanel>
        <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
         <Button x:Name="RunAiScoutButton" Content="تحليل ذكي (AI Scout)" Click="RunAiScout" Background="#1B4F72" Foreground="White" FontSize="12" Padding="10,5" ToolTip="يحلّل المجموعات المختلطة بملخّص مضغوط جداً ويقترح قواعد استخراج دقيقة"/>
         <Button Content="الموصى به فقط" Click="SelectRecommendedScannedFiles" Background="#17645E" Foreground="White" FontSize="12" Padding="10,5"/>
         <Button Content="تحديد الكل" Click="SelectAllScannedFiles" FontSize="12" Padding="10,5"/>
         <Button Content="إلغاء الكل" Click="DeselectAllScannedFiles" FontSize="12" Padding="10,5"/>
        </WrapPanel>
       </DockPanel>

       <!-- Filter & Search Bar -->
       <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="195"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="بحث في الملفات:" VerticalAlignment="Center" FontSize="12" Foreground="#496165" Margin="0,0,8,0"/>
        <TextBox Grid.Column="1" x:Name="FilesSearchBox" Padding="8,4" FontSize="12" FlowDirection="LeftToRight" TextChanged="FilterScannedFilesChanged" Margin="0,0,12,0" ToolTip="ابحث باسم الملف أو الصيغة أو جزء من العينة"/>
        <TextBlock Grid.Column="2" Text="التصنيف:" VerticalAlignment="Center" FontSize="12" Foreground="#496165" Margin="0,0,8,0"/>
        <ComboBox Grid.Column="3" x:Name="FilesVerdictFilter" FontSize="12" Padding="6,4" SelectionChanged="FilterScannedFilesChanged" SelectedIndex="0">
         <ComboBoxItem Content="الكل" Tag="all"/>
         <ComboBoxItem Content="المفعّل للترجمة فقط" Tag="included"/>
         <ComboBoxItem Content="قابل للترجمة" Tag="translatable"/>
         <ComboBoxItem Content="مختلط — راجع العينة" Tag="mixed"/>
         <ComboBoxItem Content="بيانات جانبية" Tag="auxiliary"/>
         <ComboBoxItem Content="لغة إضافية" Tag="secondary"/>
         <ComboBoxItem Content="تقني / برمجي" Tag="technical"/>
        </ComboBox>
       </Grid>

       <DataGrid Grid.Row="2" x:Name="ScannedFilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36" Background="White" BorderBrush="#D2DFDC" FontSize="13" SelectionChanged="SelectScannedFileRow">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="تضمين" Width="62">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <CheckBox IsChecked="{Binding Included, Mode=OneWay}" Click="ToggleScannedFile" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTextColumn Header="الملف" Binding="{Binding Path}" IsReadOnly="True" Width="1.4*">
          <DataGridTextColumn.ElementStyle>
           <Style TargetType="TextBlock">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Path}"/>
            <Setter Property="Padding" Value="6,0"/>
           </Style>
          </DataGridTextColumn.ElementStyle>
         </DataGridTextColumn>
         <DataGridTextColumn Header="الصيغة" Binding="{Binding Format}" IsReadOnly="True" Width="82"/>
         <DataGridTextColumn Header="النصوص" Binding="{Binding UnitsSummary}" IsReadOnly="True" Width="120"/>
         <DataGridTemplateColumn Header="التصنيف الذكي" IsReadOnly="True" Width="148">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <TextBlock Text="{Binding VerdictLabel}" Foreground="{Binding VerdictBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="6,0" ToolTip="{Binding Reason}"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTextColumn Header="عينة من النصوص" Binding="{Binding SamplesPreview}" IsReadOnly="True" Width="2*">
          <DataGridTextColumn.ElementStyle>
           <Style TargetType="TextBlock">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="#3A5458"/>
            <Setter Property="ToolTip" Value="{Binding SamplesPreview}"/>
            <Setter Property="Padding" Value="6,0"/>
           </Style>
          </DataGridTextColumn.ElementStyle>
         </DataGridTextColumn>
        </DataGrid.Columns>
       </DataGrid>

       <!-- Selected File Sample Preview -->
       <Border Grid.Row="3" Background="#F4F8F7" BorderBrush="#D5E3DF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
        <StackPanel>
         <DockPanel Margin="0,0,0,2">
          <Button x:Name="IncludeHumanOnlyButton" DockPanel.Dock="Left" Content="تفعيل النصوص البشرية فقط في هذا الملف" Click="IncludeHumanOnlySelectedFile" Visibility="Collapsed" Background="#17645E" Foreground="White" FontSize="11" Padding="9,4" Margin="0,0,8,0"/>
          <TextBlock x:Name="SelectedFilePathText" Text="اختر ملفاً من الجدول أعلاه لمعاينة أول 5 نصوص فيه قبل الترجمة." FontWeight="SemiBold" FontSize="12" Foreground="#143C42" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0"/>
         </DockPanel>
         <TextBlock x:Name="SelectedFileReasonText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,4"/>
         <TextBox x:Name="SelectedFileSamplesText" FlowDirection="LeftToRight" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="#243C42" MaxHeight="96" VerticalScrollBarVisibility="Auto" Padding="0" Margin="0"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>

     <Expander x:Name="ScanLogExpander" Grid.Row="3" Header="سجل الفحص والتشخيصات" IsExpanded="False" Margin="0,6,0,0">
      <TextBox x:Name="ScanLog" Height="110" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
     </Expander>
    </Grid>
   </TabItem>
  </TabControl>

  <!-- Bottom Status Strip -->
  <StackPanel Grid.Row="2" Margin="0,6,0,0">
   <StackPanel.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
     <Style.Triggers>
      <Trigger Property="Text" Value="">
       <Setter Property="Visibility" Value="Collapsed"/>
      </Trigger>
     </Style.Triggers>
    </Style>
   </StackPanel.Resources>
   <ProgressBar x:Name="Busy" Height="3" Visibility="Collapsed" IsIndeterminate="True"/>
   <TextBlock x:Name="Status" Text="جاهز" Foreground="#365C54"/>
   <TextBlock x:Name="TrialRecoveryStatus" TextWrapping="Wrap" Foreground="#365C54"/>
   <TextBlock x:Name="TeamStatus" TextWrapping="Wrap" Foreground="#365C54"/>
  </StackPanel>
 </Grid>
</Window>
